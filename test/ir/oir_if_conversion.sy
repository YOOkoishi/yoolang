// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-cost-model --cost-model-filter=IfConversion -O1 %s | FileCheck %s --check-prefix=COST-IFC
// RUN: %compiler --emit-cost-model --cost-model-policy=conservative --cost-model-filter=IfConversion -O1 %s | FileCheck %s --check-prefix=COST-IFC-CONS

int select_arg(int x, int y, int c) {
  if (c != 0) {
    x = y;
  }
  return x;
}

int select_arg_false_arm(int x, int y, int c) {
  if (c == 0) {
    x = y;
  }
  return x;
}

int select_const_else(int c) {
  int x;
  if (c != 0) {
    x = 7;
  } else {
    x = 13;
  }
  return x;
}

int select_bool01(int c) {
  int x = 0;
  if (c != 0) {
    x = 1;
  }
  return x;
}

int select_mask(int c) {
  int x = 0;
  if (c != 0) {
    x = -1;
  }
  return x;
}

int no_select_call(int x, int c) {
  if (c != 0) {
    x = getint();
  }
  return x;
}

int no_select_store(int a[], int c) {
  int x = 0;
  if (c != 0) {
    a[0] = 1;
    x = 2;
  }
  return x;
}

int main() {
  int a[1] = {0};
  return select_arg(1, 2, 3) + select_arg_false_arm(4, 5, 0) +
         select_const_else(1) + select_bool01(1) + select_mask(1) +
         no_select_call(6, 0) + no_select_store(a, 1);
}

// OIR-LABEL: define i32 @select_arg
// OIR: br i1
// OIR: phi

// OIR-LABEL: define i32 @select_arg_false_arm
// OIR: br i1
// OIR: phi

// OIR-LABEL: define i32 @select_const_else
// OIR: br i1
// OIR: phi

// OIR-LABEL: define i32 @select_bool01
// OIR-NOT: br i1
// OIR: zext i1
// OIR-NOT: br i1
// OIR: ret i32

// OIR-LABEL: define i32 @select_mask
// OIR-NOT: br i1
// OIR: zext i1
// OIR: sub i32 0
// OIR-NOT: br i1
// OIR: ret i32

// OIR-LABEL: define i32 @no_select_call
// OIR: br i1
// OIR: call i32 @getint

// OIR-LABEL: define i32 @no_select_store
// OIR: br i1
// OIR: store i32 1

// COST-IFC: [cost-model] target=rv64gc/lp64d policy=balanced filter=IfConversion
// COST-IFC: [cost-model] summary stage=OIR label=oir
// COST-IFC: [cost-model] OIRLocalSimplify BypassProfitability transform=IfConversion
// COST-IFC: reason=AlwaysOnLowRiskIfConversion

// COST-IFC-CONS: [cost-model] target=rv64gc/lp64d policy=conservative filter=IfConversion
// COST-IFC-CONS: [cost-model] summary stage=OIR label=oir
// COST-IFC-CONS: [cost-model] OIRLocalSimplify BypassProfitability transform=IfConversion
// COST-IFC-CONS: reason=AlwaysOnLowRiskIfConversion
