// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int g[2];

int sroa_const_indices(int x) {
  int a[2];
  a[0] = x;
  a[1] = x + 1;
  return a[0] + a[1];
}

int zero_init_sroa() {
  int a[2] = {};
  return a[0] + a[1];
}

int overwrite_same(int x, int y) {
  g[0] = x;
  g[0] = y;
  return y;
}

int noalias_forward(int x, int y) {
  g[0] = x;
  g[1] = y;
  return g[0];
}

int cross_block_forward(int x) {
  g[0] = x;
  if (x > 0) {
    return g[0];
  }
  return x;
}

int branch_noalias_forward(int x, int c) {
  g[0] = x;
  if (c != 0) {
    g[1] = 1;
  } else {
    g[1] = 2;
  }
  return g[0];
}

int dynamic_skip(int i, int x) {
  int a[4];
  a[i] = x;
  return a[i];
}

int call_escape(int x) {
  int a[2];
  a[0] = x;
  getarray(a);
  return a[0];
}

float float_sroa(float x) {
  float a[2];
  a[0] = x;
  a[1] = 1.5;
  return a[0] + a[1];
}

int nested_sroa(int x) {
  int a[2][2];
  a[1][0] = x;
  a[1][1] = 3;
  return a[1][0] + a[1][1];
}

int main() {
  return sroa_const_indices(4) + zero_init_sroa() + overwrite_same(1, 2) +
         noalias_forward(3, 4) + cross_block_forward(8) + dynamic_skip(1, 5) +
         branch_noalias_forward(9, 1) + call_escape(6) + nested_sroa(7);
}

// OIR-LABEL: define i32 @sroa_const_indices
// OIR-NOT: alloca [2 x i32]
// OIR-NOT: load i32
// OIR-NOT: store i32
// OIR: ret i32

// OIR-LABEL: define i32 @zero_init_sroa
// OIR-NOT: alloca [2 x i32]
// OIR-NOT: load i32
// OIR-NOT: store i32
// OIR: ret i32 0

// OIR-LABEL: define i32 @overwrite_same
// OIR-NOT: store i32 %x.arg
// OIR: store i32 %y.arg
// OIR: ret i32 %y.arg

// OIR-LABEL: define i32 @noalias_forward
// OIR: store i32 %x.arg
// OIR: store i32 %y.arg
// OIR-NOT: load i32
// OIR: ret i32 %x.arg

// OIR-LABEL: define i32 @cross_block_forward
// OIR: store i32 %x.arg
// OIR-NOT: load i32
// OIR: ret i32 %x.arg

// OIR-LABEL: define i32 @branch_noalias_forward
// OIR: store i32 %x.arg
// OIR-NOT: load i32
// OIR: ret i32 %x.arg

// OIR-LABEL: define i32 @dynamic_skip
// OIR: alloca [4 x i32]
// OIR: gep [4 x i32]* %a, i32 0, i32 %i.arg
// OIR: ret i32

// OIR-LABEL: define i32 @call_escape
// OIR: alloca [2 x i32]
// OIR: call i32 @getarray
// OIR: load i32
// OIR: ret i32

// OIR-LABEL: define float @float_sroa
// OIR-NOT: alloca [2 x float]
// OIR-NOT: load float
// OIR-NOT: store float
// OIR: fadd float
// OIR: ret float

// OIR-LABEL: define i32 @nested_sroa
// OIR-NOT: alloca [2 x [2 x i32]]
// OIR-NOT: load i32
// OIR-NOT: store i32
// OIR: ret i32
