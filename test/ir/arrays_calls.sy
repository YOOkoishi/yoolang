// RUN: %compiler --emit-yir %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-oir %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-mir %s | FileCheck %s --check-prefix=MIR
// RUN: %compiler --emit-asm %s | FileCheck %s --check-prefix=ASM

int a[2][3] = {{1, 2, 3}, {4, 5, 6}};

int sum(int x) {
  return a[1][x] + x;
}

int main() {
  return sum(2);
}

// YIR: yir.global @a : array<2 x array<3 x i32>>
// YIR-LABEL: yir.func @sum
// YIR: yir.array_load @a
// YIR: yir.call @sum

// OIR: @a = global [2 x [3 x i32]]
// OIR-LABEL: define i32 @sum
// OIR: gep [2 x [3 x i32]]* @a
// OIR: call i32 @sum

// MIR: global @a : [2 x [3 x i32]]
// MIR-LABEL: func @sum
// MIR: LA %v{{[0-9]+}}:gpr, @a
// MIR: CALL sum

// ASM: .globl a
// ASM-LABEL: sum:
// ASM: .Lsum.pcrel.0:
// ASM-NEXT: auipc t0, %pcrel_hi(a)
// ASM-NEXT: addi t0, t0, %pcrel_lo(.Lsum.pcrel.0)
// ASM: .Lmain.call.0:
// ASM-NEXT: auipc ra, %pcrel_hi(sum)
// ASM-NEXT: jalr ra, %pcrel_lo(.Lmain.call.0)(ra)
