// RUN: %compiler --emit-yir -O1 %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-mir -O1 %s | FileCheck %s --check-prefix=MIR

int positive() {
  int src[2][3] = {{1, 2, 3}, {4, 5, 6}};
  int view[3][2];
  int i = 0;
  int j = 0;
  while (i < 3) {
    j = 0;
    while (j < 2) {
      view[i][j] = src[j][i];
      j = j + 1;
    }
    i = i + 1;
  }

  int x = 2;
  int y = 1;
  return view[x][y];
}

int negative_source_write() {
  int src[2] = {7, 8};
  int view[2];
  int i = 0;
  while (i < 2) {
    view[i] = src[i];
    i = i + 1;
  }
  src[1] = 11;
  return view[1];
}

int positive_flatten() {
  int src[6] = {1, 2, 3, 4, 5, 6};
  int view[2][3];
  int i = 0;
  int j = 0;
  while (i < 2) {
    j = 0;
    while (j < 3) {
      view[i][j] = src[i * 3 + j];
      j = j + 1;
    }
    i = i + 1;
  }

  int x = 1;
  int y = 2;
  return view[x][y];
}

int main() {
  return positive() + negative_source_write() + positive_flatten();
}

// YIR-LABEL: yir.func @positive
// YIR-NOT: yir.array_load %view
// YIR: yir.array_load %src, [%y, %x] : i32

// YIR-LABEL: yir.func @negative_source_write
// YIR: yir.array_store {{.*}}, %src
// YIR: yir.array_load %view, [%{{.*}}] : i32

// YIR-LABEL: yir.func @positive_flatten
// YIR-NOT: yir.array_load %view
// YIR: yir.muli %x,
// YIR: yir.addi {{.*}}, %y
// YIR: yir.array_load %src, [%{{.*}}] : i32

// OIR-LABEL: define i32 @positive()
// OIR-NOT: alloca [3 x [2 x i32]]
// OIR: ret i32 6

// OIR-LABEL: define i32 @negative_source_write()
// OIR: %view = alloca [2 x i32]
// OIR: %view.1 = load i32, i32* %view.1.addr

// OIR-LABEL: define i32 @positive_flatten()
// OIR-NOT: alloca [2 x [3 x i32]]
// OIR: ret i32 6

// MIR-LABEL: func @positive() -> i32
// MIR: frame align=16 size=0 outgoing=0
// MIR: LI a0, 6

// MIR-LABEL: func @negative_source_write() -> i32
// MIR: frame objects:
// MIR: view.obj

// MIR-LABEL: func @positive_flatten() -> i32
// MIR: frame align=16 size=0 outgoing=0
// MIR: LI a0, 6
