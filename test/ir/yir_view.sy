// RUN: %compiler --emit-yir -O1 %s | FileCheck %s --check-prefix=YIR

int positive() {
  int src[2][3] = {{1, 2, 3}, {4, 5, 6}};
  int view[3][2];
  int i = 0;
  int j = 0;
  while (i < 3) {
    j = 0;
    while (j < 2) {
      view[i][j] = src[j][i];
      j = j + 1;
    }
    i = i + 1;
  }

  int x = 2;
  int y = 1;
  return view[x][y];
}

int negative_source_write() {
  int src[2] = {7, 8};
  int view[2];
  int i = 0;
  while (i < 2) {
    view[i] = src[i];
    i = i + 1;
  }
  src[1] = 11;
  return view[1];
}

int positive_flatten() {
  int src[6] = {1, 2, 3, 4, 5, 6};
  int view[2][3];
  int i = 0;
  int j = 0;
  while (i < 2) {
    j = 0;
    while (j < 3) {
      view[i][j] = src[i * 3 + j];
      j = j + 1;
    }
    i = i + 1;
  }

  int x = 1;
  int y = 2;
  return view[x][y];
}

int main() {
  return positive() + negative_source_write() + positive_flatten();
}

// YIR-LABEL: yir.func @positive
// YIR-NOT: yir.array_load %view
// YIR: yir.array_load %src, [%y, %x] : i32

// YIR-LABEL: yir.func @negative_source_write
// YIR: yir.array_store {{.*}}, %src
// YIR: yir.array_load %view, [%{{.*}}] : i32

// YIR-LABEL: yir.func @positive_flatten
// YIR-NOT: yir.array_load %view
// YIR: yir.muli %x,
// YIR: yir.addi {{.*}}, %y
// YIR: yir.array_load %src, [%{{.*}}] : i32
