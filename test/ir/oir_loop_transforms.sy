// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-cost-model --cost-model-filter=LoopRotate -O1 %s | FileCheck %s --check-prefix=COST-ROTATE
// RUN: %compiler --emit-cost-model --cost-model-filter=LoopUnswitch -O1 %s | FileCheck %s --check-prefix=COST-UNSWITCH
// RUN: %compiler --emit-cost-model --cost-model-filter=LoopUnroll -O1 %s | FileCheck %s --check-prefix=COST-UNROLL

int rotated_sum(int n) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

int unswitch_sum(int n, int flag) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    if (flag != 0) {
      sum = sum + 2;
    } else {
      sum = sum + 3;
    }
    i = i + 1;
  }
  return sum;
}

int unroll_sum4(int x) {
  int i = 0;
  int sum = x;
  while (i < 4) {
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

int unroll_multiblock_if4(int x) {
  int i = 0;
  int sum = 0;
  while (i < 4) {
    if (x > i) {
      sum = sum + x;
    }
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

int unroll_phi_latch2(int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 2) {
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      data[i] = acc + 1;
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int unroll_phi_latch3(int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 3) {
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      data[i] = acc + 1;
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int unroll_phi_latch4(int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 4) {
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      data[i] = acc + 1;
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int unroll_phi_latch5(int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 5) {
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      data[i] = acc + 1;
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int unroll_phi_latch_alpha3(int token, int slots[]) {
  int cursor = 0;
  int total = token;
  while (cursor < 3) {
    if (0 != (token + cursor) % 2) {
      slots[cursor] = total + 1;
      total = total - cursor - 1;
    } else {
      slots[cursor] = total;
      total = total + cursor + 1;
    }
    cursor = cursor + 1;
  }
  return total;
}

int no_unroll_phi_latch_call(int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 4) {
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      putint(acc);
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int no_unroll_phi_latch_side_exit(int stop, int seed, int data[]) {
  int i = 0;
  int acc = seed;
  while (i < 4) {
    if (i == stop) {
      return acc;
    }
    if ((seed + i) % 2 == 0) {
      data[i] = acc;
      acc = acc + i + 1;
    } else {
      data[i] = acc + 1;
      acc = acc - i - 1;
    }
    i = i + 1;
  }
  return acc;
}

int no_unroll_i32_wrap(int seed) {
  int i = 2147483646;
  int acc = seed;
  while (i < 2147483647) {
    if ((acc + i) % 2 == 0) {
      acc = acc + i;
    } else {
      acc = acc - i;
    }
    i = i + 2147483647;
  }
  return acc;
}

int no_unroll_i32_underflow(int seed) {
  int i = -2147483647;
  int acc = seed;
  while (i > -2147483647 - 1) {
    if ((acc + i) % 2 == 0) {
      acc = acc + i;
    } else {
      acc = acc - i;
    }
    i = i - 2147483647;
  }
  return acc;
}

int no_unroll_side_exit(int n) {
  int i = 0;
  int sum = 0;
  while (i < 4) {
    putint(i);
    if (i == n) {
      return sum;
    }
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

void final_peel_tail_loop(int depth, int data[]) {
  if (depth <= 0) {
    return;
  }
  if (data[0] == depth) {
    data[0] = data[0] + depth;
    data[1] = data[1] + depth;
    data[2] = data[2] + depth;
    data[3] = data[3] + depth;
    data[0] = data[0] + data[1];
    data[1] = data[1] + data[2];
    data[2] = data[2] + data[3];
    data[3] = data[3] + data[0];
  }
  int i = 0;
  while (i < 4) {
    if (i > 0) {
      data[i] = data[i - 1] + 1;
    }
    final_peel_tail_loop(depth - 1, data);
    i = i + 1;
  }
}

void no_full_unroll_call_loop(int data[]) {
  int i = 0;
  while (i < 4) {
    if (i > 0) {
      data[i] = data[i - 1] + 1;
      putint(data[i]);
    }
    putint(i);
    i = i + 1;
  }
}

void no_first_peel_side_exit(int n, int data[]) {
  int i = 0;
  while (i < 4) {
    if (i == n) {
      return;
    }
    if (i > 0) {
      data[i] = data[i - 1] + 1;
    }
    putint(i);
    i = i + 1;
  }
}

void no_first_peel_unknown_trip(int n, int data[]) {
  int i = 0;
  while (i < n) {
    if (i > 0) {
      data[i] = data[i - 1] + 1;
    }
    putint(i);
    i = i + 1;
  }
}

int no_first_peel_exit_value(int n, int data[]) {
  int i = 0;
  int last = 0;
  while (i < 4) {
    if (i > 0) {
      last = data[i - 1];
    }
    putint(i);
    if (data[i] == n) {
      break;
    }
    last = last + i;
    i = i + 1;
  }
  return last;
}

void no_first_peel_nested_control(int n, int data[]) {
  int i = 0;
  while (i < 4) {
    int j = 0;
    while (j < n) {
      putint(j);
      j = j + 1;
    }
    if (i > 0) {
      data[i] = data[i - 1] + 1;
    }
    putint(i);
    i = i + 1;
  }
}

int main() {
  int data[4];
  final_peel_tail_loop(2, data);
  no_full_unroll_call_loop(data);
  no_first_peel_side_exit(3, data);
  no_first_peel_unknown_trip(4, data);
  no_first_peel_nested_control(2, data);
  return rotated_sum(5) + unswitch_sum(4, 1) + unroll_sum4(7) +
         unroll_multiblock_if4(3) + no_first_peel_exit_value(9, data);
}

// OIR-LABEL: define i32 @rotated_sum
// OIR: .rot = icmp lt i32 0
// OIR: br i1
// OIR: .rot.exit = phi

// OIR-LABEL: define i32 @unswitch_sum
// OIR: br i1
// OIR: usw.
// OIR: %sum.loop = phi

// OIR-LABEL: define i32 @unroll_sum4
// OIR: .unr
// OIR-NOT: %i.loop = phi

// OIR-LABEL: define i32 @unroll_multiblock_if4
// OIR: .unr
// OIR-NOT: %i.loop = phi

// OIR-LABEL: define i32 @unroll_phi_latch2
// OIR: .unr0
// OIR: .unr1
// OIR-NOT: .unr2
// OIR: ret i32

// OIR-LABEL: define i32 @unroll_phi_latch3
// OIR: .unr0
// OIR: .unr1
// OIR: .unr2
// OIR-NOT: .unr3
// OIR: ret i32

// OIR-LABEL: define i32 @unroll_phi_latch4
// OIR: .unr0
// OIR: .unr1
// OIR: .unr2
// OIR: .unr3
// OIR-NOT: .unr4
// OIR: ret i32

// OIR-LABEL: define i32 @unroll_phi_latch5
// OIR: .unr0
// OIR: .unr1
// OIR: .unr2
// OIR: .unr3
// OIR: .unr4
// OIR-NOT: .unr5
// OIR: ret i32

// OIR-LABEL: define i32 @unroll_phi_latch_alpha3
// OIR: .unr0
// OIR: .unr1
// OIR: .unr2
// OIR-NOT: .unr3
// OIR: ret i32

// OIR-LABEL: define i32 @no_unroll_phi_latch_call
// OIR-NOT: .unr
// OIR: %acc.loop = phi
// OIR: call void @putint
// OIR: %acc.phi = phi
// OIR: .rot = icmp lt i32
// OIR-NOT: .unr

// OIR-LABEL: define i32 @no_unroll_phi_latch_side_exit
// OIR-NOT: .unr
// OIR-NOT: .rot
// OIR: %acc.loop = phi
// OIR: ret i32 %acc.loop
// OIR: ret i32 %acc.loop
// OIR: %acc.phi = phi
// OIR-NOT: .unr
// OIR-NOT: .rot

// OIR-LABEL: define i32 @no_unroll_i32_wrap
// OIR-NOT: .unr
// OIR: %i.loop = phi [2147483646,
// OIR: add i32 %i.loop, 2147483647
// OIR: .rot = icmp lt i32
// OIR-NOT: .unr

// OIR-LABEL: define i32 @no_unroll_i32_underflow
// OIR-NOT: .unr
// OIR: %i.loop = phi [-2147483647,
// OIR: sub i32 %i.loop, 2147483647
// OIR: .rot = icmp gt i32
// OIR-NOT: .unr

// OIR-LABEL: define i32 @no_unroll_side_exit
// OIR-NOT: .unr
// OIR: call void @putint
// OIR: br i1

// OIR-LABEL: define void @final_peel_tail_loop
// OIR-NOT: .peel

// OIR-LABEL: define void @no_full_unroll_call_loop
// OIR-NOT: .peel.first
// OIR: %i.loop = phi [0, %entry.0]
// OIR: icmp gt i32 %i.loop, 0
// OIR: call void @putint(i32 %i.loop)
// OIR-NOT: .unr

// OIR-LABEL: define void @no_first_peel_side_exit
// OIR-NOT: .peel.first
// OIR: ret void

// OIR-LABEL: define void @no_first_peel_unknown_trip
// OIR-NOT: .peel.first
// OIR: ret void

// OIR-LABEL: define i32 @no_first_peel_exit_value
// OIR-NOT: .peel.first
// OIR: ret i32

// OIR-LABEL: define void @no_first_peel_nested_control
// OIR-NOT: .peel.first
// OIR: ret void

// COST-ROTATE: [cost-model] target=rv64gc/lp64d policy=balanced filter=LoopRotate
// COST-ROTATE: [cost-model] OIRLoopTransforms BypassProfitability transform=LoopRotate
// COST-ROTATE: reason=AlwaysOnCanonicalization

// COST-UNSWITCH: [cost-model] target=rv64gc/lp64d policy=balanced filter=LoopUnswitch
// COST-UNSWITCH: [cost-model] OIRLoopTransforms BypassProfitability transform=LoopUnswitch
// COST-UNSWITCH: reason=LoopInvariantBranch

// COST-UNROLL: [cost-model] target=rv64gc/lp64d policy=balanced filter=LoopUnroll
// COST-UNROLL: [cost-model] OIRLoopTransforms BypassProfitability transform=LoopUnroll
// COST-UNROLL: reason=ExactSmallTripCount
// COST-UNROLL-NOT: ExactFirstIterationPeel
