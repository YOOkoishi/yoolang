// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-cost-model --cost-model-filter=LoopRotate -O1 %s | FileCheck %s --check-prefix=COST-ROTATE
// RUN: %compiler --emit-cost-model --cost-model-filter=LoopUnswitch -O1 %s | FileCheck %s --check-prefix=COST-UNSWITCH

int rotated_sum(int n) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

int unswitch_sum(int n, int flag) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    if (flag != 0) {
      sum = sum + 2;
    } else {
      sum = sum + 3;
    }
    i = i + 1;
  }
  return sum;
}

int main() {
  return rotated_sum(5) + unswitch_sum(4, 1);
}

// OIR-LABEL: define i32 @rotated_sum
// OIR: .rot = icmp lt i32 0
// OIR: br i1
// OIR: .rot.exit = phi

// OIR-LABEL: define i32 @unswitch_sum
// OIR: br i1
// OIR: .usw.exit = phi
// OIR: usw.

// COST-ROTATE: [cost-model] target=rv64gc/lp64d policy=balanced filter=LoopRotate
// COST-ROTATE: [cost-model] OIRLoopTransforms Accept transform=LoopRotate
// COST-ROTATE: reason=Profitable

// COST-UNSWITCH: [cost-model] target=rv64gc/lp64d policy=balanced filter=LoopUnswitch
// COST-UNSWITCH: [cost-model] OIRLoopTransforms Reject transform=LoopUnswitch
// COST-UNSWITCH: reason=NegativeGain
