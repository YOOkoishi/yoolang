// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int rotated_sum(int n) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    sum = sum + i;
    i = i + 1;
  }
  return sum;
}

int unswitch_sum(int n, int flag) {
  int i = 0;
  int sum = 0;
  while (i < n) {
    if (flag != 0) {
      sum = sum + 2;
    } else {
      sum = sum + 3;
    }
    i = i + 1;
  }
  return sum;
}

int main() {
  return rotated_sum(5) + unswitch_sum(4, 1);
}

// OIR-LABEL: define i32 @rotated_sum
// OIR: .rot = icmp lt i32 0
// OIR: br i1
// OIR: .rot.exit = phi

// OIR-LABEL: define i32 @unswitch_sum
// OIR: br i1
// OIR: .usw.exit = phi
// OIR: usw.
