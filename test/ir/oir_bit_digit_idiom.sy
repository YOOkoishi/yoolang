// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-cost-model --cost-model-filter=OIRBitDigitIdiom -O1 %s | FileCheck %s --check-prefix=COST
// RUN: %compiler --emit-cost-model=json --cost-model-filter=OIRBitDigitIdiom -O1 %s | FileCheck %s --check-prefix=COST-JSON

int digit_and(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 && bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int digit_or(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 || bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int digit_xor(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_trip_31(int a, int b) {
  int len = 31;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 && bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_trip_33(int a, int b) {
  int len = 33;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 && bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_divisor_negative_2(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % -2;
    int bit_b = b % -2;
    a = a / -2;
    b = b / -2;
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_divisor_3(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 3;
    int bit_b = b % 3;
    a = a / 3;
    b = b / 3;
    if (bit_a == 1 || bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_negative_digit(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == -1 && bit_b == -1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_side_effect(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    putint(bit_a);
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_power_2(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 2;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int reject_extra_liveout(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result + a;
}

int main() {
  int a = getint();
  int b = getint();
  return digit_and(a, b) + digit_or(a, b) + digit_xor(a, b) +
         reject_trip_31(a, b) + reject_divisor_3(a, b) +
         reject_trip_33(a, b) + reject_divisor_negative_2(a, b) +
         reject_negative_digit(a, b) + reject_side_effect(a, b) +
         reject_power_2(a, b) + reject_extra_liveout(a, b);
}

// OIR-LABEL: define i32 @digit_and
// OIR: %[[AND_LHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %a.arg, 0
// OIR-NEXT: %[[AND_RHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %b.arg, 0
// OIR-NEXT: %[[AND_GUARD:[A-Za-z0-9_.]+]] = and i1 %[[AND_LHS_NONNEG]], %[[AND_RHS_NONNEG]]
// OIR-NEXT: br i1 %[[AND_GUARD]], %[[AND_FAST:[A-Za-z0-9_.]+]], %[[AND_SLOW:[A-Za-z0-9_.]+]]
// OIR: [[AND_SLOW]]:
// OIR: sdiv i32
// OIR-NEXT: {{.*}}sdiv i32
// OIR: [[AND_EXIT:[A-Za-z0-9_.]+]]:
// OIR-NEXT: %[[AND_RESULT:[A-Za-z0-9_.]+]] = phi [%[[AND_VALUE:[A-Za-z0-9_.]+]], %[[AND_FAST]]], [{{.*}}, %[[AND_SLOW]]]
// OIR-NEXT: ret i32 %[[AND_RESULT]]
// OIR: [[AND_FAST]]:
// OIR-NEXT: %[[AND_VALUE]] = and i32 %a.arg, %b.arg
// OIR-NEXT: br %[[AND_EXIT]]

// OIR-LABEL: define i32 @digit_or
// OIR: %[[OR_LHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %a.arg, 0
// OIR-NEXT: %[[OR_RHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %b.arg, 0
// OIR-NEXT: %[[OR_GUARD:[A-Za-z0-9_.]+]] = and i1 %[[OR_LHS_NONNEG]], %[[OR_RHS_NONNEG]]
// OIR-NEXT: br i1 %[[OR_GUARD]], %[[OR_FAST:[A-Za-z0-9_.]+]], %[[OR_SLOW:[A-Za-z0-9_.]+]]
// OIR: [[OR_SLOW]]:
// OIR: sdiv i32
// OIR-NEXT: {{.*}}sdiv i32
// OIR: [[OR_EXIT:[A-Za-z0-9_.]+]]:
// OIR-NEXT: %[[OR_RESULT:[A-Za-z0-9_.]+]] = phi [%[[OR_VALUE:[A-Za-z0-9_.]+]], %[[OR_FAST]]], [{{.*}}, %[[OR_SLOW]]]
// OIR-NEXT: ret i32 %[[OR_RESULT]]
// OIR: [[OR_FAST]]:
// OIR-NEXT: %[[OR_DIFFERENT:[A-Za-z0-9_.]+]] = xor i32 %a.arg, %b.arg
// OIR-NEXT: %[[OR_BOTH:[A-Za-z0-9_.]+]] = and i32 %a.arg, %b.arg
// OIR-NEXT: %[[OR_VALUE]] = xor i32 %[[OR_DIFFERENT]], %[[OR_BOTH]]
// OIR-NEXT: br %[[OR_EXIT]]

// OIR-LABEL: define i32 @digit_xor
// OIR: %[[XOR_LHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %a.arg, 0
// OIR-NEXT: %[[XOR_RHS_NONNEG:[A-Za-z0-9_.]+]] = icmp ge i32 %b.arg, 0
// OIR-NEXT: %[[XOR_GUARD:[A-Za-z0-9_.]+]] = and i1 %[[XOR_LHS_NONNEG]], %[[XOR_RHS_NONNEG]]
// OIR-NEXT: br i1 %[[XOR_GUARD]], %[[XOR_FAST:[A-Za-z0-9_.]+]], %[[XOR_SLOW:[A-Za-z0-9_.]+]]
// OIR: [[XOR_SLOW]]:
// OIR: srem i32
// OIR: sdiv i32
// OIR-NEXT: {{.*}}sdiv i32
// OIR: [[XOR_EXIT:[A-Za-z0-9_.]+]]:
// OIR-NEXT: %[[XOR_RESULT:[A-Za-z0-9_.]+]] = phi [%[[XOR_VALUE:[A-Za-z0-9_.]+]], %[[XOR_FAST]]], [{{.*}}, %[[XOR_SLOW]]]
// OIR-NEXT: ret i32 %[[XOR_RESULT]]
// OIR: [[XOR_FAST]]:
// OIR-NEXT: %[[XOR_VALUE]] = xor i32 %a.arg, %b.arg
// OIR-NEXT: br %[[XOR_EXIT]]

// OIR-LABEL: define i32 @reject_trip_31
// OIR-NOT: bitdigit
// OIR: sdiv i32

// OIR-LABEL: define i32 @reject_trip_33
// OIR-NOT: bitdigit
// OIR: sdiv i32

// OIR-LABEL: define i32 @reject_divisor_negative_2
// OIR-NOT: bitdigit
// OIR: sdiv i32 {{.*}}, -2

// OIR-LABEL: define i32 @reject_divisor_3
// OIR-NOT: bitdigit
// OIR: sdiv i32 {{.*}}, 3

// OIR-LABEL: define i32 @reject_negative_digit
// OIR-NOT: bitdigit
// OIR: sdiv i32

// OIR-LABEL: define i32 @reject_side_effect
// OIR-NOT: bitdigit
// OIR: call void @putint

// OIR-LABEL: define i32 @reject_power_2
// OIR-NOT: bitdigit
// OIR: sdiv i32

// OIR-LABEL: define i32 @reject_extra_liveout
// OIR-NOT: bitdigit
// OIR: sdiv i32

// COST: [cost-model] target=rv64gc/lp64d policy=balanced filter=OIRBitDigitIdiom
// COST-COUNT-3: [cost-model] OIRBitDigitIdiom Accept transform=LoopIdiom scope=guarded_loop {{.*}} reason=Profitable

// COST-JSON: "summary": "exact full-width (32-bit) signed-div/rem-by-2 recurrence; nonnegative runtime guard selects the direct bitwise form and either-negative inputs retain the original loop"
// COST-JSON-NEXT: "rule_id": "oir.signed_digit_reconstruction.i32.guarded_nonnegative"
// COST-JSON: "summary": "exact full-width (32-bit) signed-div/rem-by-2 recurrence; nonnegative runtime guard selects the direct bitwise form and either-negative inputs retain the original loop"
// COST-JSON-NEXT: "rule_id": "oir.signed_digit_reconstruction.i32.guarded_nonnegative"
// COST-JSON: "summary": "exact full-width (32-bit) signed-div/rem-by-2 recurrence; nonnegative runtime guard selects the direct bitwise form and either-negative inputs retain the original loop"
// COST-JSON-NEXT: "rule_id": "oir.signed_digit_reconstruction.i32.guarded_nonnegative"
