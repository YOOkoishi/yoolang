// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-mir-stage=lowered -O1 %s | FileCheck %s --check-prefix=MIR
// RUN: %compiler -S -O1 %s | FileCheck %s --check-prefix=ASM

int static_clear() {
  int buf[1000];
  int i = 0;
  while (i < 1000) {
    buf[i] = 0;
    i = i + 1;
  }
  return buf[999];
}

int dynamic_clear(int n) {
  int buf[128];
  buf[0] = 3;
  int i = 0;
  while (i < n) {
    buf[i] = 0;
    i = i + 1;
  }
  return buf[0];
}

int static_fill_minus_one() {
  int buf[1000];
  int i = 0;
  while (i < 1000) {
    buf[i] = -1;
    i = i + 1;
  }
  return buf[999];
}

int dynamic_fill_minus_one(int n) {
  int buf[128];
  buf[0] = 3;
  int i = 0;
  while (i < n) {
    buf[i] = -1;
    i = i + 1;
  }
  return buf[0];
}

int static_fill_nonbyte() {
  int buf[16];
  int i = 0;
  while (i < 16) {
    buf[i] = 258;
    i = i + 1;
  }
  return buf[15];
}

float static_fill_negative_zero() {
  float buf[1000];
  int i = 0;
  while (i < 1000) {
    buf[i] = (-1.0) * 0.0;
    i = i + 1;
  }
  return 1.0 / buf[999];
}

int main() {
  return static_clear() + dynamic_clear(3) + static_fill_minus_one() +
         dynamic_fill_minus_one(3) + static_fill_nonbyte() +
         (static_fill_negative_zero() < 0.0);
}

// OIR-LABEL: define i32 @static_clear
// OIR: memzero i32* {{.*}}, i32 4000

// OIR-LABEL: define i32 @dynamic_clear
// OIR: memzero.bytes = mul i32 %n.arg, 4
// OIR: memzero i32* {{.*}}, i32 %memzero.bytes

// OIR-LABEL: define i32 @static_fill_minus_one
// OIR: memset i32* {{.*}}, i32 255, i32 4000

// OIR-LABEL: define i32 @dynamic_fill_minus_one
// OIR: memzero.bytes = mul i32 %n.arg, 4
// OIR: memset i32* {{.*}}, i32 255, i32 %memzero.bytes

// OIR-LABEL: define i32 @static_fill_nonbyte
// OIR-NOT: memset
// OIR-NOT: memzero

// OIR-LABEL: define float @static_fill_negative_zero
// OIR-NOT: memset
// OIR-NOT: memzero
// OIR: store float 0x80000000
// OIR: fdiv float 0x3f800000

// OIR-LABEL: define i32 @main

// MIR-LABEL: func @static_clear
// MIR: MEMZERO %v{{[0-9]+}}:gpr, 0, 4000

// MIR-LABEL: func @dynamic_clear
// MIR: MEMZERO %v{{[0-9]+}}:gpr, 0, %v{{[0-9]+}}:gpr

// MIR-LABEL: func @static_fill_minus_one
// MIR: MEMZERO %v{{[0-9]+}}:gpr, 255, 4000

// MIR-LABEL: func @dynamic_fill_minus_one
// MIR: MEMZERO %v{{[0-9]+}}:gpr, 255, %v{{[0-9]+}}:gpr

// ASM-LABEL: static_clear:
// ASM: .Lstatic_clear.call.0:
// ASM-NEXT: auipc ra, %pcrel_hi(memset)
// ASM-NEXT: jalr ra, %pcrel_lo(.Lstatic_clear.call.0)(ra)

// ASM-LABEL: dynamic_clear:
// ASM: bge zero, t5, .Ldynamic_clear_memzero.done.0
// ASM: addi a1, zero, 0
// ASM: .Ldynamic_clear.call.0:
// ASM-NEXT: auipc ra, %pcrel_hi(memset)
// ASM-NEXT: jalr ra, %pcrel_lo(.Ldynamic_clear.call.0)(ra)
// ASM: .Ldynamic_clear_memzero.done.0:

// ASM-LABEL: static_fill_minus_one:
// ASM: addi a1, zero, 255
// ASM: .Lstatic_fill_minus_one.call.0:
// ASM-NEXT: auipc ra, %pcrel_hi(memset)
// ASM-NEXT: jalr ra, %pcrel_lo(.Lstatic_fill_minus_one.call.0)(ra)

// ASM-LABEL: dynamic_fill_minus_one:
// ASM: bge zero, t5, .Ldynamic_fill_minus_one_memzero.done.0
// ASM: addi a1, zero, 255
// ASM: .Ldynamic_fill_minus_one.call.0:
// ASM-NEXT: auipc ra, %pcrel_hi(memset)
// ASM-NEXT: jalr ra, %pcrel_lo(.Ldynamic_fill_minus_one.call.0)(ra)
// ASM: .Ldynamic_fill_minus_one_memzero.done.0:
