// RUN: %compiler --emit-mir -O1 %s | FileCheck %s --check-prefix=MIR
// RUN: %compiler -S -O1 %s | FileCheck %s --check-prefix=ASM
// RUN: %compiler --emit-cost-model -O1 %s | FileCheck %s --check-prefix=COST-SCHED
// RUN: %compiler --emit-cost-model --cost-model-policy=conservative -O1 %s | FileCheck %s --check-prefix=COST-SCHED-CONS

int latency_gap(int a, int b, int c, int d, int e) {
  int q = a / b;
  int use_q = q + 1;
  int x = c + d;
  int y = e + 2;
  return use_q + x + y;
}

int main() {
  return latency_gap(getint(), getint(), getint(), getint(), getint());
}

// MIR-LABEL: func @latency_gap
// MIR: DIVW [[Q:[a-z][a-z0-9]*]], {{.*}}, {{.*}}
// MIR-NEXT: ADDW
// MIR-NEXT: ADDIW
// MIR-NEXT: ADDIW {{[a-z][a-z0-9]*}}, [[Q]], 1

// ASM-LABEL: latency_gap:
// ASM: divw [[Q:[a-z][a-z0-9]*]], {{.*}}, {{.*}}
// ASM-NEXT: addw
// ASM-NEXT: addiw
// ASM-NEXT: addiw {{[a-z][a-z0-9]*}}, [[Q]], 1

// COST-SCHED: [cost-model] MIRPreRAListSchedulerPass Reject transform=InstructionScheduling {{.*}} reason=NegativeGain
// COST-SCHED: [cost-model] MIRPostRAListSchedulerPass Accept transform=InstructionScheduling {{.*}} reason=Profitable

// COST-SCHED-CONS: [cost-model] MIRPreRAListSchedulerPass Reject transform=InstructionScheduling {{.*}} reason=LowConfidence
// COST-SCHED-CONS: [cost-model] MIRPostRAListSchedulerPass Reject transform=InstructionScheduling {{.*}} reason=LowConfidence
