// RUN: %compiler --emit-yir %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-oir %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-mir %s | FileCheck %s --check-prefix=MIR
// RUN: %compiler --emit-asm %s | FileCheck %s --check-prefix=ASM

int main() {
  int a = 7;
  int count = 0;
  while (a != 1) {
    count = count + 1;
    if (a % 2 == 0) {
      a = a / 2;
    } else {
      a = a * 3 + 1;
    }
  }
  return count;
}

// YIR-LABEL: yir.func @main() -> i32
// YIR: yir.while
// YIR: yir.if
// YIR: yir.return

// OIR-LABEL: define i32 @main()
// OIR: phi
// OIR: br i1
// OIR: srem
// OIR: ret i32

// MIR-LABEL: func @main() -> i32
// MIR: BNEZ
// MIR: J %epilogue
// MIR-NOT: edge.

// ASM-LABEL: main:
// ASM: bnez
// ASM: ret
