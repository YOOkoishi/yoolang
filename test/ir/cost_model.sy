// RUN: %compiler --emit-cost-model=json -O1 %s | FileCheck %s --check-prefix=JSON
// RUN: %compiler --emit-cost-model --cost-model-policy=conservative --cost-model-filter=Inline -O1 %s | FileCheck %s --check-prefix=TEXT
// RUN: %compiler -S -O1 %s | FileCheck %s --check-prefix=ASM

int add1(int x) {
  return x + 1;
}

int main() {
  int y = add1(2);
  if (y > 2) {
    return y;
  }
  return 0;
}

