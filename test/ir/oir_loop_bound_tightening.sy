// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int out[1024];

int guarded_copy(int n, int limit) {
    int j = 0;
    while (j < n) {
        if (limit < j) {
            j = j + 1;
            continue;
        }
        out[j] = j;
        j = j + 1;
    }
    return 0;
}

int liveout_counter(int n, int limit) {
    int j = 0;
    while (j < n) {
        if (limit < j) {
            j = j + 1;
            continue;
        }
        j = j + 1;
    }
    return j;
}

// OIR-LABEL: define i32 @guarded_copy
// OIR: loop.bound.tight = icmp lt i32 %limit.arg, %n.arg
// OIR: loop.bound.next = add i32 %limit.arg, 1
// OIR: loop.bound = phi
// OIR-NOT: icmp lt i32 %limit.arg, %j.loop

// OIR-LABEL: define i32 @liveout_counter
// OIR-NOT: loop.bound.tight
// OIR: ret i32
