// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int dynamic_stride_lsr(int n, int a[], int rows) {
  int cols = n / rows;
  int i = 0;
  while (i < cols) {
    int j = 0;
    while (j < rows) {
      if (i < j) {
        j = j + 1;
        continue;
      }
      int value = a[i * rows + j];
      a[j * cols + i] = value;
      a[i * rows + j] = value;
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

void call_pressure_lsr(int n, int a[]) {
  int i = 0;
  while (i < n) {
    int value = a[i];
    putint(value);
    a[i] = value + 1;
    i = i + 1;
  }
}

int stack_call_latch_lsr(int n) {
  int buf[32];
  int mirror[32];
  buf[0] = 1;
  int i = 1;
  int acc = 0;
  while (i < n) {
    int prev = buf[i - 1];
    mirror[i] = prev;
    buf[i] = prev + 1;
    acc = acc + prev;
    putint(acc);
    i = i + 1;
  }
  return acc + mirror[i - 1];
}

int stack_call_latch_dynamic_offset(int n, int base) {
  int buf[64];
  buf[base] = base;
  int i = 1;
  int acc = 0;
  while (i < n) {
    int value = buf[i + base];
    acc = acc + value;
    putint(acc);
    i = i + 1;
  }
  return acc;
}

int shared_constant_offset_lsr(int n, int a[], int b[]) {
  int i = 0;
  int acc = 0;
  while (i < n) {
    acc = acc + a[i] + a[i + 1] + b[i];
    i = i + 1;
  }
  return acc;
}

// OIR-LABEL: define i32 @dynamic_stride_lsr
// OIR-NOT: mul i32 %j.loop
// OIR: %a.addr.ptr = phi
// OIR: %elem.addr.ptr = phi
// OIR-NOT: mul i32 %j.loop
// OIR: %a = load i32, i32* %a.addr.ptr
// OIR-NEXT: store i32 %a, i32* %elem.addr.ptr
// OIR-NEXT: %{{.*}} = add i32 %j.loop, 1
// OIR-NOT: mul i32 %j.loop
// OIR: %a.addr.next = gep i32* %a.addr.ptr, i32 1
// OIR-NEXT: %elem.addr.next = gep i32* %elem.addr.ptr, i32 %v0

// OIR-LABEL: define void @call_pressure_lsr
// OIR-NOT: .ptr = phi
// OIR: call void @putint
// OIR-NOT: .ptr = phi

// OIR-LABEL: define i32 @stack_call_latch_lsr
// OIR: {{.*}}.stack.ptr = phi
// OIR: {{.*}}.stack.ptr = phi
// OIR: load i32, i32* %{{.*}}.stack.ptr
// OIR: call void @putint
// OIR: {{.*}}.stack.next = gep

// OIR-LABEL: define i32 @stack_call_latch_dynamic_offset
// OIR-NOT: .stack.ptr
// OIR: call void @putint
// OIR-NOT: .stack.ptr

// OIR-LABEL: define i32 @shared_constant_offset_lsr
// OIR-COUNT-2: .ptr = phi
// OIR-NOT: .ptr = phi
// OIR: .shared.off = gep i32* %{{.*}}.ptr, i32
