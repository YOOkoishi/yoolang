// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int dynamic_stride_lsr(int n, int a[], int rows) {
  int cols = n / rows;
  int i = 0;
  while (i < cols) {
    int j = 0;
    while (j < rows) {
      if (i < j) {
        j = j + 1;
        continue;
      }
      int value = a[i * rows + j];
      a[j * cols + i] = value;
      a[i * rows + j] = value;
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

// OIR-LABEL: define i32 @dynamic_stride_lsr
// OIR-NOT: mul i32 %j.loop
// OIR: %a.addr.ptr = phi
// OIR: %elem.addr.ptr = phi
// OIR-NOT: mul i32 %j.loop
// OIR: %a = load i32, i32* %a.addr.ptr
// OIR-NEXT: store i32 %a, i32* %elem.addr.ptr
// OIR-NEXT: %{{.*}} = add i32 %j.loop, 1
// OIR-NOT: mul i32 %j.loop
// OIR: %a.addr.next = gep i32* %a.addr.ptr, i32 1
// OIR-NEXT: %elem.addr.next = gep i32* %elem.addr.ptr, i32 %v0
