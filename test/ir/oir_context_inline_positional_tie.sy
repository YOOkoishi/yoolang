// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR
// RUN: %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=COST
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=unsupported %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=UNSUPPORTED
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=cleanup-budget %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=CLEANUP
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=verify %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=VERIFY-FAIL
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=typed-import %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=TYPED-IMPORT
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=commit-preflight %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=PREFLIGHT
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=commit-after-first %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=AFTER-FIRST
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=cost-reject %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=COST-REJECT
// RUN: env YOOLANG_TEST_OIR_RESIDUAL_FAILURE=tie-budget %compiler --emit-cost-model=json --cost-model-filter=ConstantArgumentSpecialization -O1 %s | FileCheck %s --check-prefix=TIE-BUDGET-COST

int positional_branch(int left, int right) {
  if (left == 0) {
    return right + 17;
  }
  if (right == 0) {
    return left - 19;
  }
  return left - right;
}

int tie_sink;

int repeated_step(int value, int mode) {
  tie_sink = tie_sink + value;
  int mixed = value * 3 + 1;
  mixed = mixed * 5 + 2;
  mixed = mixed * 7 + 4;
  mixed = mixed * 9 + 6;
  if (mode == 0) {
    return mixed + 3;
  }
  return mixed - 5;
}

int later_control_leaf(int value, int passthrough, int select) {
  if (select == 7) {
    return value + passthrough + 11;
  }
  return value - passthrough - 13;
}

int swapped_bindings(int input) {
  int left_constant = positional_branch(0, input);
  int right_constant = positional_branch(input, 0);
  return left_constant + right_constant;
}

int same_block_dependent(int left, int right) {
  int result = left + right;
  int index = 0;
  while (index < 4) {
    int first = repeated_step(result, 0);
    int second = repeated_step(result, 0);
    result = first + second;
    index = index + 1;
  }
  return result;
}

int later_control(int input) {
  return later_control_leaf(input, input, 7);
}

int main() {
  int input = getint();
  return swapped_bindings(input) + same_block_dependent(input, input + 1) +
         later_control(input);
}

// OIR-LABEL: define i32 @swapped_bindings
// OIR-NOT: call i32 @positional_branch
// OIR: ret i32
// OIR-LABEL: define i32 @same_block_dependent
// OIR-NOT: call i32 @repeated_step
// OIR: ret i32
// OIR-LABEL: define i32 @later_control
// OIR-NOT: call i32 @later_control_leaf
// OIR: ret i32

