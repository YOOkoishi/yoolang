// CHECK: yir.vector.reduce_or {{.*}} : i32
// CHECK: yir.vector.reduce_xor {{.*}} : i32

// OIR: @global_one = global <1 x i32> <i32 1>
// OIR: @global_mask = global <3 x i1> <i1 1, i1 0, i1 1>
// OIR-LABEL: define <3 x i32> @round_trip(
// OIR: vector.fptosi
// OIR: splat i32 2 to <3 x i32>
// OIR: icmp ge <3 x i32>
// OIR: select <3 x i1>
