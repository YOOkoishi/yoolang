// RUN: %compiler --emit-mir -O1 %s | FileCheck %s --check-prefix=MIR-O1
// RUN: %compiler -S -O1 %s | FileCheck %s --check-prefix=ASM

int cmp_lt(int a, int b) {
  if (a < b) {
    return a + 1;
  }
  return b + 2;
}

int cmp_eq(int a, int b) {
  if (a == b) {
    return 11;
  }
  return 22;
}

int cmp_ge_const(int a) {
  if (a >= 1234) {
    return a + 3;
  }
  return a - 4;
}

int cmp_ne_zero(int a) {
  if (a != 0) {
    return 31;
  }
  return 41;
}

int float_ne_branch(float a, float b) {
  if (a != b) {
    return 51;
  }
  return 61;
}

int nonnegative_divrem(int x) {
  if (x >= 0) {
    return x / 8 + x % 16;
  }
  return x / 8 + x % 16;
}

int parity_branch(int x) {
  if (x % 2 == 0) {
    return 3;
  }
  return 5;
}

int address_offset_fold(int x) {
  int data[8];
  data[3] = x;
  getarray(data);
  return data[3];
}

int phi_shuffle(int n) {
  int a = 1;
  int b = 2;
  while (n > 0) {
    int next_a = b;
    int next_b = a + b;
    a = next_a;
    b = next_b;
    n = n - 1;
  }
  return a + b;
}

int main() {
  return cmp_lt(1, 2) + cmp_eq(3, 3) + nonnegative_divrem(32) +
         cmp_ge_const(1235) + cmp_ne_zero(9) +
         parity_branch(9) + address_offset_fold(7) + phi_shuffle(4);
}

// MIR-O1-LABEL: func @cmp_lt
// MIR-O1: BGE
// MIR-O1-NOT: SLT

// MIR-O1-LABEL: func @cmp_eq
// MIR-O1: BNE
// MIR-O1-NOT: SEQZ

// MIR-O1-LABEL: func @cmp_ge_const
// MIR-O1: LI {{.*}}, 1234
// MIR-O1: BLT
// MIR-O1-NOT: XORI
// MIR-O1-NOT: SLT

// MIR-O1-LABEL: func @cmp_ne_zero
// MIR-O1: BEQ
// MIR-O1-NOT: SNEZ

// MIR-O1-LABEL: func @float_ne_branch
// MIR-O1: FEQ.S
// MIR-O1: BNEZ
// MIR-O1-NOT: XORI

// MIR-O1-LABEL: func @nonnegative_divrem
// MIR-O1: SRLIW {{.*}}, 3
// MIR-O1: ANDI {{.*}}, 15
// MIR-O1: SRAIW {{.*}}, 3

// MIR-O1-LABEL: func @parity_branch
// MIR-O1-NOT: SRAIW
// MIR-O1: ANDI {{.*}}, 1
// MIR-O1-NOT: SRAIW
// MIR-O1: B{{EQ|NE}} {{.*}}, zero
// MIR-O1-NOT: SRAIW

// MIR-O1-LABEL: func @address_offset_fold
// MIR-O1: STORE_MEM_OFF {{.*}}, 12, i32
// MIR-O1: LOAD_MEM_OFF {{.*}}, 12, i32

// MIR-O1-LABEL: func @phi_shuffle
// MIR-O1: BGE zero, {{.*}}, %edge.entry.0.to.while.end.3
// MIR-O1-NOT: J %edge.entry.0.to.while.body.2
// MIR-O1: edge.entry.0.to.while.body.2:
// MIR-O1: edge.while.body.2.to.while.body.2:
// MIR-O1-NOT: J %while.body.2
// MIR-O1: while.body.2:
// MIR-O1: ADDW
// MIR-O1: ADDIW {{.*}}, -1
// MIR-O1: BLT
// MIR-O1: edge.while.body.2.to.while.end.3:
// MIR-O1-NOT: J %while.end.3
// MIR-O1: while.end.3:

// ASM-LABEL: cmp_lt:
// ASM: bge
// ASM-LABEL: cmp_eq:
// ASM: bne
// ASM-LABEL: cmp_ge_const:
// ASM: li {{.*}}, 1234
// ASM: blt
// ASM-NOT: xori
// ASM-LABEL: cmp_ne_zero:
// ASM: beq
// ASM-NOT: snez
// ASM-LABEL: float_ne_branch:
// ASM: feq.s
// ASM: bnez
// ASM-NOT: xori
// ASM-LABEL: nonnegative_divrem:
// ASM: srliw {{.*}}, 3
// ASM: andi {{.*}}, 15
// ASM-LABEL: parity_branch:
// ASM-NOT: sraiw
// ASM: andi {{.*}}, 1
// ASM-NOT: sraiw
// ASM: b{{eq|ne}} {{.*}}, zero
// ASM-NOT: sraiw
// ASM-LABEL: address_offset_fold:
// ASM: sw {{.*}}, 12(
// ASM: lw {{.*}}, 12(
// ASM-LABEL: phi_shuffle:
// ASM: bge zero, {{.*}}, .Lphi_shuffle_edge.entry.0.to.while.end.3
// ASM-NOT: j .Lphi_shuffle_edge.entry.0.to.while.body.2
// ASM: .Lphi_shuffle_edge.entry.0.to.while.body.2:
// ASM: .Lphi_shuffle_edge.while.body.2.to.while.body.2:
// ASM-NOT: j .Lphi_shuffle_while.body.2
// ASM: .Lphi_shuffle_while.body.2:
// ASM: addw
// ASM: addiw {{.*}}, -1
// ASM: blt zero, {{.*}}, .Lphi_shuffle_edge.while.body.2.to.while.body.2
// ASM: .Lphi_shuffle_edge.while.body.2.to.while.end.3:
// ASM-NOT: j .Lphi_shuffle_while.end.3
// ASM: .Lphi_shuffle_while.end.3:
