// RUN: %compiler --emit-yir -O1 %s | FileCheck %s --check-prefix=YIR

int g[4];

int same_store_load(int x, int y) {
  g[0] = x;
  g[1] = y;
  return g[0];
}

int dynamic_exact(int a[], int i, int x) {
  a[i] = x;
  return a[i];
}

int alias_blocks(int a[], int i, int j, int x, int y) {
  a[i] = x;
  a[j] = y;
  return a[i];
}

int branch_same(int c, int x) {
  if (c != 0) {
    g[0] = x;
  } else {
    g[0] = x;
  }
  return g[0];
}

int branch_diff(int c, int x, int y) {
  if (c != 0) {
    g[0] = x;
  } else {
    g[0] = y;
  }
  return g[0];
}

int call_local_preserve(int x) {
  int a[2];
  a[0] = x;
  putint(0);
  return a[0];
}

int call_arg_clobber(int x) {
  int a[2];
  a[0] = x;
  getarray(a);
  return a[0];
}

int assign_index_changes(int a[], int i) {
  int before = a[i];
  i = i + 1;
  return a[i] + before;
}

int store_mutable_value(int a[], int x) {
  a[0] = x;
  x = x + 1;
  return a[0];
}

int main() {
  int a[4];
  return same_store_load(3, 4) + dynamic_exact(a, 1, 5) +
         alias_blocks(a, 1, 2, 6, 7) + branch_same(1, 8) +
         branch_diff(1, 9, 10) + call_local_preserve(11) +
         call_arg_clobber(12) + assign_index_changes(a, 1) +
         store_mutable_value(a, 13);
}

// YIR-LABEL: yir.func @same_store_load
// YIR-NOT: yir.array_load
// YIR: yir.return %x

// YIR-LABEL: yir.func @dynamic_exact
// YIR-NOT: yir.array_load
// YIR: yir.return %x

// YIR-LABEL: yir.func @alias_blocks
// YIR: yir.array_load

// YIR-LABEL: yir.func @branch_same
// YIR-NOT: yir.array_load
// YIR: yir.return %x

// YIR-LABEL: yir.func @branch_diff
// YIR: yir.array_load

// YIR-LABEL: yir.func @call_local_preserve
// YIR-NOT: yir.array_load
// YIR: yir.return %x

// YIR-LABEL: yir.func @call_arg_clobber
// YIR: yir.array_load

// YIR-LABEL: yir.func @assign_index_changes
// YIR: yir.array_load
// YIR: yir.assign %i
// YIR: yir.array_load

// YIR-LABEL: yir.func @store_mutable_value
// YIR: yir.array_store %x
// YIR: yir.assign %x
// YIR: yir.array_load
