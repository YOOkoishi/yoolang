// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int big_a[200][200];
int big_b[200][200];
int mid_a[32][32];
int mid_b[32][32];
int flat_a[64];
int flat_b[64];
int recurrence_state[1][1];
int recurrence_sink[32][32];

int tiled_copy() {
  int i = 0;
  int j = 0;
  while (i < 200) {
    j = 0;
    while (j < 200) {
      big_b[i][j] = big_a[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return big_b[0][0];
}

int interchange_copy() {
  int i = 0;
  int j = 0;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      mid_b[j][i] = mid_a[j][i];
      j = j + 1;
    }
    i = i + 1;
  }
  return mid_b[0][0];
}

int aliasing_params_keep_order(int lhs[][32], int rhs[][32]) {
  int i = 0;
  int j = 0;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      lhs[i][j] = rhs[j][i] + rhs[j][i] + rhs[j][i];
      j = j + 1;
    }
    i = i + 1;
  }
  return lhs[1][0] + lhs[0][1];
}

int keep_loop_carried_order() {
  int i = 0;
  int j = 0;
  recurrence_state[0][0] = 1;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      recurrence_state[0][0] = recurrence_state[0][0] * 2 + i;
      recurrence_sink[j][i] = i + j;
      j = j + 1;
    }
    i = i + 1;
  }
  return recurrence_state[0][0];
}

int unroll_jam_copy() {
  int i = 0;
  int j = 0;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      mid_b[i][j] = mid_a[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return mid_b[0][0];
}

int lane_copy_sum() {
  int i = 0;
  int sum = 0;
  while (i < 64) {
    flat_b[i] = flat_a[i];
    sum = sum + flat_b[i];
    i = i + 1;
  }
  return sum;
}

int repeat_invariant_sum(int n) {
  int r = 0;
  int i = 0;
  int total = 7;
  while (r < n) {
    i = 0;
    while (i < 64) {
      total = total + flat_a[i] * flat_a[i];
      i = i + 1;
    }
    r = r + 1;
  }
  return total;
}

int repeat_keeps_live_iv(int n) {
  int r = 0;
  int total = 0;
  while (r < n) {
    total = total + flat_a[0];
    r = r + 1;
  }
  return total + r;
}

int main() {
  return tiled_copy() + interchange_copy() + unroll_jam_copy() + lane_copy_sum() +
         repeat_invariant_sum(3) + repeat_keeps_live_iv(3) + keep_loop_carried_order();
}

// YIR-LABEL: yir.func @tiled_copy
// YIR: .tile.step = yir.const.i32 20
// YIR: yir.for %i.tile
// YIR: .tile.end = yir.addi
// YIR: yir.for %j.tile

// YIR-LABEL: yir.func @interchange_copy
// YIR: yir.for %j =
// YIR: yir.for %i =

// YIR-LABEL: yir.func @aliasing_params_keep_order
// YIR-NOT: .jam.
// YIR: yir.for %i =
// YIR: yir.for %j =

// POLY: dependence WAR stmt #{{[0-9]+}} -> stmt #{{[0-9]+}} memory=%rhs.arg dependent=true distance=unknown relation={{.*}}exact=false

// YIR-LABEL: yir.func @keep_loop_carried_order
// YIR: yir.for %i =
// YIR: yir.for %j =
// YIR: yir.array_store {{.*}}, @recurrence_state

// YIR-LABEL: yir.func @unroll_jam_copy
// YIR: .jam.step = yir.const.i32 2
// YIR: .jam.iv = yir.addi

// YIR-LABEL: yir.func @lane_copy_sum
// YIR: .vec.step = yir.const.i32 4
// YIR: .vec.iv = yir.addi

// YIR-LABEL: yir.func @repeat_invariant_sum
// YIR: .repeat.has_trip = yir.icmp gt %n
// YIR: yir.if
// YIR: .repeat.delta = yir.var : i32
// YIR: yir.for %i =
// YIR: .repeat.scaled = yir.muli
// YIR: yir.assign %total

// YIR-LABEL: yir.func @repeat_keeps_live_iv
// YIR: yir.for %r =
// YIR-NOT: .repeat.scaled
// YIR: yir.return
