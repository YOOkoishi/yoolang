// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

const int C = 16;
int G;

int algebra(int x) {
  int a = x + 0;
  int b = 0 + a;
  int c = b * 1;
  int d = 1 * c;
  int e = d * 0;
  int f = e / 1;
  int g = f % 1;
  return g;
}

int folded_branch() {
  int x = 3 * 4 + 5;
  if (x == 17) {
    return 1;
  }
  return 0;
}

int zext_cmp(int x) {
  int b = x < 10;
  if (b != 0) {
    return 1;
  }
  return 0;
}

int global_const(int x) {
  return x / C + x % C;
}

int range_gated_rem(int x) {
  if (x >= 0) {
    return x % 16;
  }
  return x % 16;
}

int range_gated_negative_divisor_rem(int x) {
  if (x >= 0) {
    return x % -8;
  }
  return x % -8;
}

int even_remainder_branch(int x) {
  if (x % 2 == 0) {
    return 1;
  }
  return 0;
}

int product_even_remainder_branch(int x, int y) {
  if ((x * y) % 2 == 0) {
    return 1;
  }
  return 0;
}

int negated_by_mul(int x) {
  return x * -1;
}

int bitwise_not_by_sub(int x) {
  return -1 - x;
}

int cancel_sub_add(int x, int y) {
  return x - (x + y);
}

int cancel_add_sub(int x, int y) {
  return (x - y) + y;
}

int cancel_sub_rhs(int x, int y) {
  return (x + y) - y;
}

int tail_sum(int n, int acc) {
  if (n == 0) {
    return acc;
  }
  return tail_sum(n - 1, acc + n);
}

int tail_sum_merged_return(int n, int acc) {
  int result;
  if (n == 0) {
    result = acc;
  } else {
    result = tail_sum_merged_return(n - 1, acc + n);
  }
  return result;
}

int tail_global_countdown() {
  if (G == 0) {
    return 0;
  }
  G = G - 1;
  return tail_global_countdown();
}

int passthrough(int x) {
  return x;
}

int tail_sum_wrapped(int n, int acc) {
  if (n == 0) {
    return acc;
  }
  return passthrough(tail_sum_wrapped(n - 1, acc + n));
}

int main() {
  G = 3;
  return algebra(42) + folded_branch() + zext_cmp(3) + global_const(99) +
         range_gated_rem(23) + range_gated_negative_divisor_rem(23) + tail_sum(4, 0) +
         even_remainder_branch(42) + product_even_remainder_branch(6, 7) +
         negated_by_mul(5) + bitwise_not_by_sub(5) +
         cancel_sub_add(7, 3) + cancel_add_sub(7, 3) + cancel_sub_rhs(7, 3) +
         tail_sum_merged_return(4, 0) + tail_global_countdown() + tail_sum_wrapped(4, 0);
}

// OIR-LABEL: define i32 @algebra
// OIR: ret i32 0
// OIR-NOT: add i32
// OIR-NOT: mul i32
// OIR-NOT: sdiv
// OIR-NOT: srem

// OIR-LABEL: define i32 @folded_branch
// OIR-NOT: br i1
// OIR: ret i32 1

// OIR-LABEL: define i32 @zext_cmp
// OIR: icmp lt i32 %x.arg, 10
// OIR-NOT: zext
// OIR-NOT: icmp ne i32
// OIR: br i1

// OIR-LABEL: define i32 @global_const
// OIR-NOT: load i32, i32* @C
// OIR: sdiv i32 %x.arg, 16
// OIR: srem i32 %x.arg, 16
// OIR-NOT: load i32, i32* @C

// OIR-LABEL: define i32 @range_gated_rem
// OIR: and i32 %x.arg, 15
// OIR: srem i32 %x.arg, 16

// OIR-LABEL: define i32 @range_gated_negative_divisor_rem
// OIR: and i32 %x.arg, 7
// OIR: srem i32 %x.arg, -8

// OIR-LABEL: define i32 @even_remainder_branch
// OIR: and i32 %x.arg, 1
// OIR: icmp eq i32
// OIR-NOT: srem
// OIR: br i1

// OIR-LABEL: define i32 @product_even_remainder_branch
// OIR: and i32 %x.arg, %y.arg
// OIR: and i32 {{.*}}, 1
// OIR: icmp eq i32
// OIR-NOT: mul i32
// OIR-NOT: srem
// OIR: br i1

// OIR-LABEL: define i32 @negated_by_mul
// OIR: sub i32 0, %x.arg
// OIR-NOT: mul i32

// OIR-LABEL: define i32 @bitwise_not_by_sub
// OIR: xor i32 %x.arg, -1
// OIR-NOT: sub i32 -1

// OIR-LABEL: define i32 @cancel_sub_add
// OIR: sub i32 0, %y.arg
// OIR-NOT: add i32 %x.arg, %y.arg

// OIR-LABEL: define i32 @cancel_add_sub
// OIR: ret i32 %x.arg
// OIR-NOT: add i32
// OIR-NOT: sub i32

// OIR-LABEL: define i32 @cancel_sub_rhs
// OIR: ret i32 %x.arg
// OIR-NOT: add i32
// OIR-NOT: sub i32

// OIR-LABEL: define i32 @tail_sum
// OIR: %n.arg.tail = phi
// OIR-NOT: call i32 @tail_sum

// OIR-LABEL: define i32 @tail_sum_merged_return
// OIR: %n.arg.tail = phi
// OIR-NOT: call i32 @tail_sum_merged_return

// OIR-LABEL: define i32 @tail_global_countdown
// OIR: %G.slot.ssa = phi
// OIR-NOT: call i32 @tail_global_countdown

// OIR-LABEL: define i32 @tail_sum_wrapped
// OIR: %n.arg.tail = phi
// OIR-NOT: call i32 @tail_sum_wrapped

// OIR-LABEL: define i32 @main
