// RUN: %compiler --emit-oir -O1 %s | FileCheck %s --check-prefix=OIR

int algebra(int x) {
  int a = x + 0;
  int b = 0 + a;
  int c = b * 1;
  int d = 1 * c;
  int e = d * 0;
  int f = e / 1;
  int g = f % 1;
  return g;
}

int folded_branch() {
  int x = 3 * 4 + 5;
  if (x == 17) {
    return 1;
  }
  return 0;
}

int zext_cmp(int x) {
  int b = x < 10;
  if (b != 0) {
    return 1;
  }
  return 0;
}

int main() {
  return algebra(42) + folded_branch() + zext_cmp(3);
}

// OIR-LABEL: define i32 @algebra
// OIR: ret i32 0
// OIR-NOT: add i32
// OIR-NOT: mul i32
// OIR-NOT: sdiv
// OIR-NOT: srem

// OIR-LABEL: define i32 @folded_branch
// OIR: br %if.then
// OIR-NOT: br i1
// OIR: ret i32 1

// OIR-LABEL: define i32 @zext_cmp
// OIR: icmp lt i32 %x.arg, 10
// OIR-NOT: zext
// OIR-NOT: icmp ne i32
// OIR: br i1
