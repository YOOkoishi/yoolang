int a[8][32];
int c[8];

int reduce_rows(int n) {
  int i = 0;
  while (i < 8) {
    c[i] = -1;
    i = i + 1;
  }

  int j = 0;
  while (j < n) {
    int k = 0;
    int sum = 0;
    while (k < 32) {
      sum = sum + a[j][k];
      k = k + 1;
    }
    c[j] = sum;
    j = j + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < 8) {
    checksum = checksum + c[i];
    i = i + 1;
  }
  return checksum;
}

int main() {
  int i = 0;
  while (i < 8) {
    int j = 0;
    while (j < 32) {
      a[i][j] = (i + j) % 7;
      j = j + 1;
    }
    i = i + 1;
  }

  putint(reduce_rows(getint()));
  putch(10);
  putint(reduce_rows(getint()));
  putch(10);
  putint(reduce_rows(getint()));
  putch(10);
  putint(reduce_rows(getint()));
  putch(10);
  return 0;
}
