int recurrence_state[1][1];
int recurrence_sink[32][32];

int main() {
  int i = 0;
  int j = 0;
  recurrence_state[0][0] = 1;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      recurrence_state[0][0] = recurrence_state[0][0] * 2 + i;
      recurrence_sink[j][i] = i + j;
      j = j + 1;
    }
    i = i + 1;
  }
  putint(recurrence_state[0][0]);
  putch(10);
  return 0;
}
