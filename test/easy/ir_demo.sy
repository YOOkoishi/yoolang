const int N = 4;
int data[4] = {1, 2, 3, 4};

int adjust(int x) {
  if (x % 2 == 0)
    return x * 2;
  return x + 1;
}

int main() {
  int i = 0;
  int sum = 0;
  int tmp[2] = {0, 1};
  while (i < N) {
    int v = adjust(data[i]);
    if (v > 4)
      sum = sum + v;
    else
      sum = sum - v;
    tmp[i % 2] = sum;
    i = i + 1;
  }
  return sum + tmp[1] - tmp[0];
}
