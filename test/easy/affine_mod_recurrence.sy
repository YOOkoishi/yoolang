int advance_modulo(int value, int count) {
  int index = 0;
  while (index < count) {
    value = (value + 3) % 5;
    index = index + 1;
  }
  return value;
}

int main() {
  int cases = 0;
  while (cases < 8) {
    int value = getint();
    int count = getint();
    putint(advance_modulo(value, count));
    putch(10);
    cases = cases + 1;
  }
  return 0;
}
