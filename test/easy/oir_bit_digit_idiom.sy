int digit_and(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 && bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int digit_or(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a == 1 || bit_b == 1) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int digit_xor(int a, int b) {
  int len = 32;
  int result = 0;
  int power = 1;
  while (len) {
    int bit_a = a % 2;
    int bit_b = b % 2;
    a = a / 2;
    b = b / 2;
    if (bit_a != bit_b) result = result + power;
    power = power * 2;
    len = len - 1;
  }
  return result;
}

int main() {
  int i = 0;
  while (i < 8) {
    int a = getint();
    int b = getint();
    putint(digit_and(a, b));
    putch(32);
    putint(digit_or(a, b));
    putch(32);
    putint(digit_xor(a, b));
    putch(10);
    i = i + 1;
  }
  return 0;
}
