int shared[32][32];

int update(int lhs[][32], int rhs[][32]) {
  int i = 0;
  int j = 0;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      lhs[i][j] = rhs[j][i] + rhs[j][i] + rhs[j][i];
      j = j + 1;
    }
    i = i + 1;
  }
  return lhs[1][0] + lhs[0][1];
}

int main() {
  int i = 0;
  int j = 0;
  while (i < 32) {
    j = 0;
    while (j < 32) {
      shared[i][j] = i * 37 + j + 1;
      j = j + 1;
    }
    i = i + 1;
  }

  putint(update(shared, shared));
  putch(10);
  return 0;
}
