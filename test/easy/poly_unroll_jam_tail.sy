int shared[2][64];
int data[2][64][64];
int output[2][64];
int plain_output[2][64];

int reduce_prefix(int n) {
  int i = 0;
  while (i < 2) {
    int j = 0;
    while (j < n) {
      int k = 0;
      int sum = 0;
      while (k < 64) {
        if (shared[i][k] > 0) {
          sum = sum + (shared[i][k] * 3 + 1) * data[i][j][k];
        }
        k = k + 1;
      }
      output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < 2) {
    int j = 0;
    while (j < n) {
      checksum = checksum + output[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return checksum;
}

int reduce_plain_prefix(int n) {
  int i = 0;
  while (i < 2) {
    int j = 0;
    while (j < n) {
      int k = 0;
      int sum = 0;
      while (k < 64) {
        sum = sum + data[i][j][k] + shared[i][k];
        k = k + 1;
      }
      plain_output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  int checksum = 0;
  i = 0;
  while (i < 2) {
    int j = 0;
    while (j < n) {
      checksum = checksum + plain_output[i][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return checksum;
}

int main() {
  int i = 0;
  while (i < 2) {
    int j = 0;
    while (j < 64) {
      int k = 0;
      while (k < 64) {
        shared[i][k] = k % 7 - 3;
        data[i][j][k] = (j + 2) * (k % 5 - 2);
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  int n = 0;
  while (n < 10) {
    putint(reduce_prefix(n));
    putch(10);
    putint(reduce_plain_prefix(n));
    putch(10);
    n = n + 1;
  }
  return 0;
}
