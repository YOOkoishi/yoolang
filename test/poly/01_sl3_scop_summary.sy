// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int x[250][250][250];
int y[250][250][250];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 0;
  j = 0;
  k = 0;
  while (i < N) {
    j = 0;
    k = 0;
    while (j < N) {
      k = 0;
      while (k < N) {
        x[i][j][k] = 1;
        y[i][j][k] = 0;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] + x[i][j - 1][k]
                    + x[i][j + 1][k] + x[i][j][k - 1] + x[i][j][k + 1]
                    + x[i - 1][j - 1][k - 1]) / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// POLY: polyhedral {
// POLY: canonical_loops: 6
// POLY: scops: 2
// POLY: scop #0 {
// POLY: symbols: [%N]
// POLY: statements: 2
// POLY: stmt #0 op=yir.array_store loops=[%i, %j, %k]
// POLY: stmt #1 op=yir.array_store loops=[%i, %j, %k]
// POLY: scop #1 {
// POLY: symbols: [%N]
// POLY: statements: 8
// POLY: models: 2
// POLY: model #0 {
// POLY: statements: 2
// POLY: model #1 {
// POLY: statements: 8
// POLY: dependences: 14
// POLY-DAG: dependence WAW stmt #0 -> stmt #0 memory=@x dependent=true
// POLY-DAG: dependence WAW stmt #1 -> stmt #1 memory=@y dependent=true
// POLY-DAG: dependence WAR stmt #2 -> stmt #9 memory=@x dependent=true
// POLY-DAG: dependence RAW stmt #9 -> stmt #2 memory=@x dependent=true distance=loop-carried [1, 0, 0]
// POLY-DAG: dependence RAW stmt #9 -> stmt #4 memory=@x dependent=true distance=loop-carried [0, 1, 0]
// POLY-DAG: dependence RAW stmt #9 -> stmt #6 memory=@x dependent=true distance=loop-carried [0, 0, 1]
// POLY-DAG: dependence RAW stmt #9 -> stmt #8 memory=@x dependent=true distance=loop-carried [1, 1, 1]
// POLY-DAG: dependence WAW stmt #9 -> stmt #9 memory=@x dependent=true
// POLY: }
