// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int x[250][250][250];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] + x[i][j - 1][k]
                    + x[i][j + 1][k] + x[i][j][k - 1] + x[i][j][k + 1]
                    + x[i - 1][j - 1][k - 1]) / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// POLY: polyhedral {
// POLY: canonical_loops: 3
// POLY: scops: 1
// POLY: statements: 8
// POLY: models: 1
// POLY: model #0 {
// POLY: params: [%N]
// POLY: statements: 8
// POLY: schedule: [%i, %j, %k]
// POLY: domain: %i in [1, %N - 1); %j in [1, %N - 1); %k in [1, %N - 1)
// POLY-DAG: read @x[%i - 1, %j, %k]
// POLY-DAG: read @x[%i + 1, %j, %k]
// POLY-DAG: read @x[%i, %j - 1, %k]
// POLY-DAG: read @x[%i, %j + 1, %k]
// POLY-DAG: read @x[%i, %j, %k - 1]
// POLY-DAG: read @x[%i, %j, %k + 1]
// POLY-DAG: read @x[%i - 1, %j - 1, %k - 1]
// POLY: write @x[%i, %j, %k]
// POLY: dependences: 8
// POLY-DAG: dependence WAR stmt #0 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #1 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #2 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #3 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #4 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #5 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAR stmt #6 -> stmt #7 memory=@x dependent=true
// POLY-DAG: dependence WAW stmt #7 -> stmt #7 memory=@x dependent=true
// POLY: }
