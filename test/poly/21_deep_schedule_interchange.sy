// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s
// RUN: %compiler --emit-cost-model=json -O1 --polyhedral %s | FileCheck %s --check-prefix=COST

int source[64][64][64];
int target[64][64][64];

int deep_schedule_interchange() {
  int i = 0;
  int j = 0;
  int k = 0;
  while (i < 64) {
    j = 0;
    while (j < 64) {
      k = 0;
      while (k < 64) {
        target[i][k][j] = source[i][k][j];
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return target[0][0][0];
}

int main() {
  return 0;
}

// CHECK-LABEL: yir.func @deep_schedule_interchange
// CHECK: yir.for %i =
// CHECK: yir.for %k =
// CHECK: yir.for %j =

// COST: "transform": "LoopInterchange"
// COST-NEXT: "pass": "YIRPolyhedralTransformPass"
// COST-NEXT: "candidate_id": "band-interchange"
// COST-NEXT: "scope": "0:1"
// COST-NEXT: "action": "Accept"
// COST: "estimated_gain": 16
// COST: "before": {
// COST: "estimated_cycles": 48
// COST: "after": {
// COST: "estimated_cycles": 32
