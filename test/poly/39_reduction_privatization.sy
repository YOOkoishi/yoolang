// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int values[128];
int sum[1];

int main() {
  int n = getint();
  int i = 0;
  sum[0] = 3;
  while (i < n) {
    sum[0] = sum[0] + values[i];
    i = i + 1;
  }
  return sum[0];
}

// POLY: reduction=true
// POLY: dependence RAW stmt #{{[0-9]+}} -> stmt #{{[0-9]+}} memory=@sum
// POLY-SAME: reduction=true

// YIR-LABEL: yir.func @main
// YIR: %poly.reduction.acc{{[0-9]+}} = yir.var : i32 =
// YIR: yir.for %i =
// YIR-NOT: yir.array_load @sum
// YIR: %[[NEXT:[^ ]+]] = yir.addi %poly.reduction.acc{{[0-9]+}},
// YIR: yir.assign %poly.reduction.acc{{[0-9]+}}, %[[NEXT]]
// YIR-NOT: yir.array_store {{.*}}, @sum
// YIR: }
// YIR: yir.array_store %poly.reduction.acc{{[0-9]+}}, @sum, [{{.*}}]
