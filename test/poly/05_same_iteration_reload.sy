// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY
// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int a[128];
int b[128];

int main() {
  int i;
  int N;
  int t;
  int sum;

  N = getint();
  sum = 0;
  i = 0;
  while (i < N) {
    a[i] = i + 1;
    t = a[i];
    b[i] = t;
    sum = sum + t;
    i = i + 1;
  }

  return sum;
}

// POLY: polyhedral {
// POLY: canonical_loops: 1
// POLY: scops: 1
// POLY: statements: 3
// POLY: models: 1
// POLY: model #0 {
// POLY: params: [%N]
// POLY: stmt #0 op=yir.array_store
// POLY: domain: %i in [0, %N)
// POLY: write @a[%i]
// POLY: stmt #1 op=yir.array_load
// POLY: domain: %i in [0, %N)
// POLY: read @a[%i]
// POLY: stmt #2 op=yir.array_store
// POLY: write @b[%i]
// POLY: dependences: 3
// POLY-DAG: dependence RAW stmt #0 -> stmt #1 memory=@a dependent=true
// POLY-DAG: dependence WAW stmt #0 -> stmt #0 memory=@a dependent=true
// POLY-DAG: dependence WAW stmt #2 -> stmt #2 memory=@b dependent=true
// POLY: }

// YIR: yir.array_store %v9, @a, [%i]
// YIR-NOT: yir.array_load @a, [%i]
// YIR: yir.assign %t, %v9
// YIR: yir.array_store %t, @b, [%i]
