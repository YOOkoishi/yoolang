// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-cost-model=json -O1 --polyhedral %s | FileCheck %s --check-prefix=COST

int a[64][64];
int b[64][64];

int fused_nests() {
  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      a[i][j] = i + j;
      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      b[i][j] = i - j;
      j = j + 1;
    }
    i = i + 1;
  }
  return a[0][0] + b[0][0];
}

int main() {
  return fused_nests();
}

// YIR-LABEL: yir.func @fused_nests
// YIR: yir.for %i =
// YIR: yir.for %j =
// YIR: yir.array_store {{.*}}, @a, [%i, %j]
// YIR: yir.array_store {{.*}}, @b, [%i, %j]
// YIR-NOT: yir.for
// YIR: yir.return

// COST: "candidate_id": "band-fusion"
// COST: "action": "Accept"
// COST: "candidate_id": "band-fusion"
// COST: "action": "Accept"
