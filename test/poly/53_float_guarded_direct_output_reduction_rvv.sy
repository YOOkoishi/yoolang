// RUN: %compiler --emit-vector-plan -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-PLAN
// RUN: %compiler --emit-oir -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-OIR
// RUN: %compiler -S -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-ASM
// RUN: %compiler -S -O1 -march=rv64gc -fvectorize --polyhedral %s | FileCheck %s --check-prefix=SCALAR-ASM
// RUN: %compiler -S -O1 -fvectorize -mrvv-deployment=fat --polyhedral %s | FileCheck %s --check-prefix=FAT

float gate[64][64];
float input[64][64];
float output[64][64];

int main() {
  int row = 0;
  while (row < 64) {
    int column = 0;
    while (column < 64) {
      gate[row][column] = 1.0;
      if (column % 2 == 0) {
        gate[row][column] = -1.0;
      }
      input[row][column] = 0.5;
      output[row][column] = -1.0;
      column = column + 1;
    }
    row = row + 1;
  }

  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      int k = 0;
      float sum = 0.0;
      while (k < 64) {
        if (gate[i][k] > 0.0) {
          sum = sum + input[k][j];
        }
        k = k + 1;
      }
      output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  if (output[0][0] != 16.0 || output[0][63] != 16.0 ||
      output[63][0] != 16.0 || output[63][63] != 16.0) {
    return 1;
  }
  return 0;
}

// RVV-PLAN: "vectorizer": "slp"
// RVV-PLAN: "code": "VECTORIZED"
// RVV-PLAN: "explanation": "SLP_VECTORIZED: transformed and verified 4 fixed-width SLP pack(s)"
// RVV-PLAN: "scalable": false
// RVV-PLAN: "minimum_lanes": 2
// RVV-PLAN: "uses_mask": false

// RVV-OIR-DAG: %slp.guarded.reduction.phi = phi {{.*}} : <2 x float>
// RVV-OIR-DAG: %slp.guarded.reduction.load = vp.load <2 x float>
// RVV-OIR-DAG: %slp.guarded.reduction.update = vp.fadd <2 x float>
// RVV-OIR-DAG: %slp.guarded.reduction.merge = phi {{.*}} : <2 x float>
// RVV-OIR-DAG: vp.store <2 x float> %slp.guarded.reduction.merge
// RVV-OIR-NOT: %slp.guarded.reduction.term

// RVV-ASM-LABEL: main:
// RVV-ASM-NOT: vmset.m
// RVV-ASM-NOT: vmand.mm
// RVV-ASM-DAG: vsetivli
// RVV-ASM-DAG: vle32.v
// RVV-ASM-DAG: vfadd.vv
// RVV-ASM-DAG: vse32.v
// RVV-ASM-NOT: vmset.m
// RVV-ASM-NOT: vmand.mm

// SCALAR-ASM-LABEL: main:
// SCALAR-ASM-NOT: vset
// SCALAR-ASM-NOT: vfadd.vv
// SCALAR-ASM: .size main

// FAT-LABEL: __yoolang_scalar_main:
// FAT-NOT: vset
// FAT: .size __yoolang_scalar_main
// FAT-LABEL: __yoolang_rvv_main:
// FAT-DAG: vsetivli
// FAT-DAG: vle32.v
// FAT-DAG: vfadd.vv
// FAT-DAG: vse32.v
