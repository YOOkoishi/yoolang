// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[32][32][32];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] + x[i][j - 1][k]
                    + x[i][j + 1][k] + x[i][j][k - 1] + x[i][j][k + 1]
                    + x[i - 1][j - 1][k - 1]) / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// YIR-LABEL: yir.func @main()
// YIR-NOT: poly.wave
// YIR-NOT: parallel
// YIR: [[INIT:%poly.stencil.init[0-9]+]] = yir.array_load @x, [%i, %j,
// YIR: [[CARRY:%poly.stencil.carry[0-9]+]] = yir.var : i32 = [[INIT]]
// YIR: yir.for %k =
// YIR-NOT: poly.wave
// YIR-NOT: parallel
// YIR-NOT: yir.array_load @x, [%i, %j, %poly.add
// YIR: yir.addi {{.*}}[[CARRY]]
// YIR: yir.array_store {{.*}}, @x, [%i, %j, %k]
// YIR-NEXT: yir.assign [[CARRY]],
