// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY
// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[32][32][32];

int main() {
  int i;
  int j;
  int k;
  int N;

  N = getint();

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = x[i][j][k + 1] + 1;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// POLY-NOT: distance=loop-carried [0, 0, 1]

// YIR-NOT: poly.stencil.carry
