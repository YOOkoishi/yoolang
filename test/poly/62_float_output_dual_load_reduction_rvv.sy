// RUN: %compiler --emit-vector-plan -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-PLAN
// RUN: %compiler --emit-oir -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-OIR
// RUN: %compiler -S -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-ASM
// RUN: %compiler -S -O1 -march=rv64gc -fvectorize --polyhedral %s | FileCheck %s --check-prefix=SCALAR-ASM

float weight[64][64];
float input[64][64];
float output[64][64];

int main() {
  int row = 0;
  while (row < 64) {
    int column = 0;
    while (column < 64) {
      weight[row][column] = 0.5;
      input[row][column] = 2.0;
      output[row][column] = -1.0;
      column = column + 1;
    }
    row = row + 1;
  }

  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      int k = 0;
      float sum = 0.0;
      while (k < 64) {
        sum = sum + weight[k][j] * input[k][j];
        k = k + 1;
      }
      output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  if (output[0][0] != 64.0 || output[0][63] != 64.0 ||
      output[63][0] != 64.0 || output[63][63] != 64.0) {
    return 1;
  }
  return 0;
}

// RVV-PLAN: "vectorizer": "slp"
// RVV-PLAN: "code": "VECTORIZED"
// RVV-PLAN: "explanation": "SLP_VECTORIZED: transformed and verified 5 scalable SLP pack(s)"
// RVV-PLAN: "minimum_lanes": 2
// RVV-PLAN: "uses_mask": false

// RVV-OIR-DAG: %slp.reduction.load = vp.load <vscale x 2 x float>
// RVV-OIR-DAG: %slp.reduction.common.load = vp.load <vscale x 2 x float>
// RVV-OIR-DAG: %slp.reduction.term = vp.fmul <vscale x 2 x float>
// RVV-OIR-DAG: %slp.reduction.update = vp.fadd <vscale x 2 x float>
// RVV-OIR-DAG: vp.store <vscale x 2 x float> %slp.reduction.update

// RVV-ASM-LABEL: main:
// RVV-ASM-DAG: vle32.v
// RVV-ASM-DAG: vfmul.vv
// RVV-ASM-DAG: vfadd.vv
// RVV-ASM-DAG: vse32.v

// SCALAR-ASM-LABEL: main:
// SCALAR-ASM-NOT: vset
// SCALAR-ASM-NOT: vfmul.vv
// SCALAR-ASM: .size main
