// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s
// RUN: %compiler --emit-cost-model=json -O1 --polyhedral %s | FileCheck %s --check-prefix=COST

int a[64][64];
int b[64][64];
int c[64];

int guarded_rows(int n) {
  int j = 0;
  while (j < n) {
    int k = 0;
    int sum = 0;
    while (k < 64) {
      if (a[j][k] % 2 == 0) {
        sum = sum + a[j][k] * b[j][k];
      }
      k = k + 1;
    }
    c[j] = sum;
    j = j + 1;
  }
  return c[0];
}

int main() {
  return guarded_rows(getint());
}

// CHECK-LABEL: yir.func @guarded_rows
// CHECK: %[[PAIRS:[^ ]+]] = yir.divsi %n,
// CHECK: %[[ALIGNED:[^ ]+]] = yir.muli %[[PAIRS]],
// CHECK: yir.for %j = {{.*}} to %[[ALIGNED]] step %poly.reduction.output_step{{[0-9]+}}
// CHECK-COUNT-2: %poly.reduction.acc{{[0-9]+}} = yir.var : i32 =
// CHECK-COUNT-2: yir.if
// CHECK: yir.for %j = %[[ALIGNED]] to %n step
// CHECK: yir.array_store {{.*}}, @c, [%j]

// COST: "candidate_id": "output-reduction-unroll-and-jam-factor-2"
// COST: "action": "Accept"
// COST: "summary": "independent output points are unrolled and jammed over one guarded side-effect-free integer reduction loop; lane-invariant shared_ops=0, shared_loads=0, shared_branches=0"
