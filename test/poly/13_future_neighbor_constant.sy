// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[32][32][32];

int main() {
  int i;
  int j;
  int k;
  int N;

  N = getint();

  i = 0;
  j = 0;
  k = 0;
  while (i < N) {
    j = 0;
    k = 0;
    while (j < N) {
      k = 0;
      while (k < N) {
        x[i][j][k] = 1;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = x[i + 1][j][k] + x[i][j + 1][k] + x[i][j][k + 1];
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// YIR-DAG: [[F0:%poly.future.c[0-9]+]] = yir.const.i32 1 : i32
// YIR-DAG: [[F1:%poly.future.c[0-9]+]] = yir.const.i32 1 : i32
// YIR-DAG: [[F2:%poly.future.c[0-9]+]] = yir.const.i32 1 : i32
// YIR-NOT: yir.array_load @x
// YIR: yir.array_store {{.*}}, @x, [%i, %j, %k]
