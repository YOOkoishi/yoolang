// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[32][32][32];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] + x[i][j - 1][k]
                    + x[i][j + 1][k] + x[i][j][k - 1] + x[i - 1][j + 1][k])
                    / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  return 0;
}

// YIR-NOT: poly.wave
// YIR: yir.for %k =
