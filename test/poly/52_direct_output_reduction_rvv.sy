// RUN: %compiler --emit-vector-plan -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-PLAN
// RUN: %compiler --emit-oir -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-OIR
// RUN: %compiler -S -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-ASM
// RUN: %compiler -S -O1 -march=rv64gc -fvectorize --polyhedral %s | FileCheck %s --check-prefix=SCALAR-ASM

int input[64][64];
int output[64][64];

int main() {
  int row = 0;
  while (row < 64) {
    int column = 0;
    while (column < 64) {
      input[row][column] = 1;
      output[row][column] = -1;
      column = column + 1;
    }
    row = row + 1;
  }

  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      int k = 0;
      int sum = 0;
      while (k < 64) {
        sum = sum + input[k][j];
        k = k + 1;
      }
      output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }

  if (output[0][0] != 64 || output[0][63] != 64 ||
      output[63][0] != 64 || output[63][63] != 64) {
    return 1;
  }
  return 0;
}

// RVV-PLAN: "vectorizer": "slp"
// RVV-PLAN: "code": "VECTORIZED"
// RVV-PLAN: "explanation": "SLP_VECTORIZED: transformed and verified 3 scalable SLP pack(s)"
// RVV-PLAN: "scalable": true
// RVV-PLAN: "minimum_lanes": 4
// RVV-PLAN: "uses_mask": false

// RVV-OIR: %slp.reduction.phi = phi {{.*}} : <vscale x 4 x i32>
// RVV-OIR: %slp.reduction.load = vp.load <vscale x 4 x i32>
// RVV-OIR: %slp.reduction.update = vp.add <vscale x 4 x i32>
// RVV-OIR: vp.store <vscale x 4 x i32> %slp.reduction.update
// RVV-OIR-NOT: %slp.reduction.term

// RVV-ASM-LABEL: main:
// RVV-ASM-NOT: vmset.m
// RVV-ASM-NOT: vmand.mm
// RVV-ASM: vle32.v
// RVV-ASM: vadd.vv
// RVV-ASM: vse32.v
// RVV-ASM-NOT: vmset.m
// RVV-ASM-NOT: vmand.mm

// SCALAR-ASM-LABEL: main:
// SCALAR-ASM-NOT: vset
// SCALAR-ASM-NOT: vle32.v
// SCALAR-ASM: .size main
