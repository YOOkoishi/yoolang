// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int a[128];
int b[128];

int main() {
  int i;
  int N;

  N = getint();
  i = 0;
  while (i < N - 1) {
    b[i] = a[i];
    a[i + 1] = b[i];
    i = i + 1;
  }

  return 0;
}

// POLY: polyhedral {
// POLY: canonical_loops: 1
// POLY: scops: 1
// POLY: statements: 4
// POLY: models: 1
// POLY: model #0 {
// POLY: params: [%N]
// POLY: statements: 4
// POLY: stmt #0 op=yir.array_load
// POLY: schedule: [%i]
// POLY: domain: %i in [0, %N - 1)
// POLY: read @a[%i]
// POLY: stmt #1 op=yir.array_store
// POLY: schedule: [%i]
// POLY: domain: %i in [0, %N - 1)
// POLY: write @b[%i]
// POLY: stmt #2 op=yir.array_load
// POLY: schedule: [%i]
// POLY: domain: %i in [0, %N - 1)
// POLY: read @b[%i]
// POLY: stmt #3 op=yir.array_store
// POLY: schedule: [%i]
// POLY: domain: %i in [0, %N - 1)
// POLY: write @a[%i + 1]
// POLY: dependences: 4
// POLY-DAG: dependence WAR stmt #0 -> stmt #3 memory=@a dependent=true
// POLY-DAG: dependence WAW stmt #1 -> stmt #1 memory=@b dependent=true
// POLY-DAG: dependence RAW stmt #1 -> stmt #2 memory=@b dependent=true
// POLY-DAG: dependence WAW stmt #3 -> stmt #3 memory=@a dependent=true
// POLY: }
