// RUN: %compiler --emit-oir -O1 -march=rv64gcv -fvectorize --polyhedral %s | FileCheck %s --check-prefix=RVV-OIR

float gate[64][64];
float weight[64][64];
float input[64][64];
float output[64][64];

int main() {
  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      int k = 0;
      float sum = 0.0;
      while (k < 64) {
        if (gate[k][j] > 0.0) {
          sum = sum + weight[j][k] * input[k][j];
        }
        k = k + 1;
      }
      output[i][j] = sum;
      j = j + 1;
    }
    i = i + 1;
  }
  return 0;
}

// The weight loads are neither a broadcast nor contiguous across the output
// lanes.  The dual-load recipe must therefore fail closed.
// RVV-OIR-NOT: slp.lane.guard.common.load
// RVV-OIR-NOT: slp.lane.guard.term
// RVV-OIR: ret i32 0
