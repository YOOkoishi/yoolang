// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR
// RUN: %compiler --emit-cost-model=json -O1 --polyhedral %s | FileCheck %s --check-prefix=COST

int a[64][64];
int row[64][64];
int column[64][64];

int main() {
  int i = 0;
  while (i < 64) {
    int j = 0;
    while (j < 64) {
      a[i][j] = a[j][i] + row[i][0] + column[0][j];
      j = j + 1;
    }
    i = i + 1;
  }
  return a[0][0];
}

// YIR-LABEL: yir.func @main
// YIR: %{{.*}}tile.step = yir.const.i32 16
// YIR: yir.for %{{.*}}tile =
// YIR: yir.for %{{.*}}tile =
// YIR: yir.for %i =
// YIR: yir.for %j =

// COST: "transform": "LoopTiling"
// COST-NEXT: "pass": "YIRPolyhedralTransformPass"
// COST-NEXT: "candidate_id": "band-tile"
// COST-NEXT: "scope": "0"
// COST-NEXT: "action": "Accept"
// COST: "summary": "polyhedral dependence legality; Presburger tiled schedule legality; backend rectangular tiling tile=16"
