// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[16][16][16];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 0;
  j = 0;
  k = 0;
  while (i < N) {
    j = 0;
    k = 0;
    while (j < N) {
      k = 0;
      while (k < N) {
        x[i][j][k] = 1;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] +
                      x[i][j - 1][k] + x[i][j + 1][k] +
                      x[i][j][k - 1] + x[i][j][k + 1] +
                      x[i - 1][j - 1][k - 1]) / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  putarray(N, x[0][0]);
  putarray(N, x[N / 2][N / 2]);
  putarray(N, x[i - 1][j - 1]);
  return 0;
}

// YIR: yir.global @poly.storage.xbuf : array<2 x array<16 x array<16 x i32>>> = zero
// YIR: yir.global @poly.storage.row0 : array<16 x i32> = zero
// YIR: yir.global @poly.storage.rowmid : array<16 x i32> = zero
// YIR: yir.global @poly.storage.rowlast : array<16 x i32> = zero
// YIR-NOT: yir.global @x
// YIR: [[BJ:%poly.storage.bj[0-9]+]] = yir.const.i32 16 : i32
// YIR: [[BK:%poly.storage.bk[0-9]+]] = yir.const.i32 64 : i32
// YIR: [[JT:%poly.storage.jt[0-9]+]] = yir.var : i32 =
// YIR: yir.for [[JT]] =
// YIR: [[KT:%poly.storage.kt[0-9]+]] = yir.var : i32 =
// YIR: yir.for [[KT]] =
// YIR: yir.for %k = [[KT]]
// YIR: yir.array_load @poly.storage.xbuf
// YIR: yir.array_store {{.*}}, @poly.storage.xbuf
// YIR: yir.call @putarray(%N, %poly.storage.row.decay
// YIR: yir.call @putarray(%N, %poly.storage.row.decay
// YIR: yir.call @putarray(%N, %poly.storage.row.decay
// YIR-NOT: @x
