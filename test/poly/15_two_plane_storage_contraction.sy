// RUN: %compiler --emit-yir -O1 --polyhedral %s | FileCheck %s --check-prefix=YIR

int x[16][16][16];

int main() {
  int i;
  int j;
  int k;
  int f;
  int N;

  N = getint();
  f = getint();

  i = 0;
  j = 0;
  k = 0;
  while (i < N) {
    j = 0;
    k = 0;
    while (j < N) {
      k = 0;
      while (k < N) {
        x[i][j][k] = 1;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  i = 1;
  j = 1;
  k = 1;
  while (i < N - 1) {
    j = 1;
    k = 1;
    while (j < N - 1) {
      k = 1;
      while (k < N - 1) {
        x[i][j][k] = (x[i - 1][j][k] + x[i + 1][j][k] +
                      x[i][j - 1][k] + x[i][j + 1][k] +
                      x[i][j][k - 1] + x[i][j][k + 1] +
                      x[i - 1][j - 1][k - 1]) / f;
        k = k + 1;
      }
      j = j + 1;
    }
    i = i + 1;
  }

  putarray(N, x[0][0]);
  putarray(N, x[N / 2][N / 2]);
  putarray(N, x[i - 1][j - 1]);
  return 0;
}

// YIR: module {
// YIR-NOT: poly.storage
// YIR: yir.global @x : array<16 x array<16 x array<16 x i32>>> = zero
// YIR-NOT: poly.storage
// YIR: yir.call @putarray(%N,
// YIR-NOT: poly.storage
// YIR: yir.call @putarray(%N,
// YIR-NOT: poly.storage
// YIR: yir.call @putarray(%N,
// YIR-NOT: poly.storage
