// RUN: %compiler --emit-poly -O1 --polyhedral %s | FileCheck %s --check-prefix=POLY

int a[64];
int b[64];

int main() {
  int i;
  int n;
  int k;

  n = getint();
  k = getint();
  i = 0;
  while (i < n) {
    if (i < k) {
      a[i] = 1;
    } else {
      a[i] = 2;
    }
    b[i] = a[i];
    i = i + 1;
  }

  return 0;
}

// POLY: scops: 1
// POLY: models: 1
// POLY: model #0 {
// POLY: statements: 4
// POLY: stmt #0 op=yir.array_store
// POLY: schedule-map: [%i] -> [{{[0-9]+}}, %i, {{[0-9]+}}, 0]
// POLY: schedule-bands: [offset=1 count=1 permutable=true coincident=true reduction=false] optimized=true
// POLY: domain-set: dims=[%i] params=[%k, %n] { 0 <= %i and %i < %n and %i < %k }
// POLY: stmt #1 op=yir.array_store
// POLY: schedule-map: [%i] -> [{{[0-9]+}}, %i, {{[0-9]+}}, 1]
// POLY: domain-set: dims=[%i] params=[%k, %n] { 0 <= %i and %i < %n and %i >= %k }
// POLY: stmt #2 op=yir.array_load
// POLY: schedule-map: [%i] -> [{{[0-9]+}}, %i, {{[0-9]+}}, 2]
// POLY: stmt #3 op=yir.array_store
// POLY: schedule-map: [%i] -> [{{[0-9]+}}, %i, {{[0-9]+}}, 3]
// POLY: dependence RAW stmt #0 -> stmt #2 memory=@a dependent=true distance=same-iteration [0] relation={source=[%i], target=[%i], params=[%k, %n], disjuncts={{[1-9][0-9]*}}, exact=true}
// POLY: dependence RAW stmt #1 -> stmt #2 memory=@a dependent=true distance=same-iteration [0] relation={source=[%i], target=[%i], params=[%k, %n], disjuncts={{[1-9][0-9]*}}, exact=true}
