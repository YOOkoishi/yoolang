// Known regression: optimized source masked_load/masked_store crashes in OIR.
// Reproducer: compiler %s --emit-oir -O1/-O2/-O3 -march=rv64gcv
int data[7] = {0, 10, 20, 30, 40, 50, 60};
int output[7] = {};

int main() {
  mask<7> active = mask<7>{1, 0, 1, 1, 0, 1, 1};
  vector<int,7> loaded = masked_load(data, active, vector<int,7>(-1000));
  masked_store(output, active, loaded + 5);
  return output[0] != 5;
}
