// Derived from test/performance/fft2.sy: pointwise modular multiplication.
int main() {
  vector<int,7> lhs = vector<int,7>{1, 2, 3, 4, 5, 6, 7};
  vector<int,7> rhs = vector<int,7>{7, 6, 5, 4, 3, 2, 1};
  vector<int,7> result = (lhs * rhs) % vector<int,7>(17);
  if (result[0] != 7 || result[1] != 12 || result[2] != 15 ||
      result[3] != 16 || result[4] != 15 || result[5] != 12 ||
      result[6] != 7) {
    return 1;
  }
  return 0;
}
