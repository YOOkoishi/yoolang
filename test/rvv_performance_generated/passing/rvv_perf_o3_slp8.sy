// Eight adjacent independent statements extend the O3-only SLP coverage.
int input[8] = {3, -2, 7, 11, -9, 4, 13, 6};
int output[8] = {};

int main() {
  int a0 = input[0];
  int a1 = input[1];
  int a2 = input[2];
  int a3 = input[3];
  int a4 = input[4];
  int a5 = input[5];
  int a6 = input[6];
  int a7 = input[7];
  output[0] = a0 * 3 + 1;
  output[1] = a1 * 3 + 1;
  output[2] = a2 * 3 + 1;
  output[3] = a3 * 3 + 1;
  output[4] = a4 * 3 + 1;
  output[5] = a5 * 3 + 1;
  output[6] = a6 * 3 + 1;
  output[7] = a7 * 3 + 1;
  if (output[0] != 10 || output[1] != -5 ||
      output[2] != 22 || output[3] != 34 ||
      output[4] != -26 || output[5] != 13 ||
      output[6] != 40 || output[7] != 19) return 1;
  return 0;
}
