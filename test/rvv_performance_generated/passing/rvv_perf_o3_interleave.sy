// O3 explores factor-two interleaving; O2 must retain factor one.
int input[17] = {0, 13, 26, 39, 52, 65, 78, 91, 104,
                 117, 130, 143, 156, 169, 182, 195, 208};
int output[17] = {};

int main() {
  int n = getint();
  int i = 0;
  while (i < n) {
    output[i] = input[i] + 7;
    i = i + 1;
  }
  if (output[0] != 7 || output[1] != 20 || output[2] != 33 ||
      output[3] != 46 || output[4] != 59 || output[5] != 72 ||
      output[6] != 85 || output[7] != 98 || output[8] != 111 ||
      output[9] != 124 || output[10] != 137 || output[11] != 150 ||
      output[12] != 163 || output[13] != 176 || output[14] != 189 ||
      output[15] != 202 || output[16] != 215) {
    return 1;
  }
  return 0;
}
