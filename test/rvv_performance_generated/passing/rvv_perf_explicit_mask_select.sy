// Mask/select form of boundary handling found in convolution kernels.
int main() {
  vector<int,7> values = vector<int,7>{-3, -2, -1, 0, 1, 2, 3};
  mask<7> inside = values >= vector<int,7>(0);
  vector<int,7> selected = select(inside, values * 2, -values);
  if (selected[0] != 3 || selected[1] != 2 || selected[2] != 1 ||
      selected[3] != 0 || selected[4] != 2 || selected[5] != 4 ||
      selected[6] != 6) {
    return 1;
  }
  return 0;
}
