// Three iterations are a negative control: the cost model should keep this scalar.
int input[3] = {4, 5, 6};
int output[3] = {};

int main() {
  int i = 0;
  while (i < 3) {
    output[i] = input[i] * 9 - 2;
    i = i + 1;
  }
  i = 0;
  while (i < 3) {
    if (output[i] != input[i] * 9 - 2) return 10 + i;
    i = i + 1;
  }
  return 0;
}
