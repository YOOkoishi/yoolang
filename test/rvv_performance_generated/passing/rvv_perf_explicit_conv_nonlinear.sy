// Derived from conv2d nonlinear(): independent integer polynomial and remainder.
int main() {
  vector<int,7> input = vector<int,7>{-5, -1, 0, 1, 2, 7, 11};
  vector<int,7> result = (input * input + input * 3 - 7) % 97;
  if (result[0] != 3 || result[1] != -9 || result[2] != -7 ||
      result[3] != -3 || result[4] != 3 || result[5] != 63 ||
      result[6] != 50) {
    return 1;
  }
  return 0;
}
