// Derived from transpose: transpose a 4x4 tile with fixed-vector shuffles.
int main() {
  vector<int,4> r0 = vector<int,4>{0, 1, 2, 3};
  vector<int,4> r1 = vector<int,4>{10, 11, 12, 13};
  vector<int,4> r2 = vector<int,4>{20, 21, 22, 23};
  vector<int,4> r3 = vector<int,4>{30, 31, 32, 33};

  vector<int,4> p01lo = shuffle(r0, r1, vector<int,4>{0, 4, 1, 5});
  vector<int,4> p23lo = shuffle(r2, r3, vector<int,4>{0, 4, 1, 5});
  vector<int,4> p01hi = shuffle(r0, r1, vector<int,4>{2, 6, 3, 7});
  vector<int,4> p23hi = shuffle(r2, r3, vector<int,4>{2, 6, 3, 7});
  vector<int,4> c0 = shuffle(p01lo, p23lo, vector<int,4>{0, 1, 4, 5});
  vector<int,4> c1 = shuffle(p01lo, p23lo, vector<int,4>{2, 3, 6, 7});
  vector<int,4> c2 = shuffle(p01hi, p23hi, vector<int,4>{0, 1, 4, 5});
  vector<int,4> c3 = shuffle(p01hi, p23hi, vector<int,4>{2, 3, 6, 7});

  if (c0[0] != 0 || c0[1] != 10 || c0[2] != 20 || c0[3] != 30 ||
      c1[0] != 1 || c1[1] != 11 || c1[2] != 21 || c1[3] != 31 ||
      c2[0] != 2 || c2[1] != 12 || c2[2] != 22 || c2[3] != 32 ||
      c3[0] != 3 || c3[1] != 13 || c3[2] != 23 || c3[3] != 33) {
    return 1;
  }
  return 0;
}
