      "dedupe_group": "pointer-chasing-hash",
      "tags": ["pointer-chasing", "indirect-memory"],
      "hotspot": false
    },
    {
      "id": "dependent-scheduling3",
      "source": "test/performance/optimization_scheduling3.sy",
      "input": "test/performance/optimization_scheduling3.in",
      "output": "test/performance/optimization_scheduling3.out",
