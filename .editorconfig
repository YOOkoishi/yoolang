# top-most EditorConfig, so stop searching here
root = true

# All files
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ files
[*.{c,cpp,h,hpp}]
indent_size = 4

# CMake or xmake
[*.{cmake,lua}]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
