# xmake 临时文件和构建产物
.xmake/
build/
*.bmake/

# LSP 配置与缓存 (如果是使用 xmake project -k compile_commands 生成)
compile_commands.json
.cache/
.ccls-cache/
.clangd/

# 编译生成的中间文件及目标文件 (即使不在 build 目录下也最好排除)
*.o
*.obj
*.so
*.dll
*.dylib
*.a
*.lib
*.exe
*.out
*.app

# Test references are source artifacts, not build outputs.
!test/**/*.out
!test/**/*.in
!test/**/*.sy
!test/**/*.yir
!test/**/*.txt

# Keep extracted tests, but do not commit bulky downloaded archives.
test/**/*.zip
*.zip

# 编辑器与 IDE 临时文件和配置
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.bak
__pycache__/
*.py[cod]

# 操作系统自动生成的文件
.DS_Store
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/


参考/**

!runtime/*
